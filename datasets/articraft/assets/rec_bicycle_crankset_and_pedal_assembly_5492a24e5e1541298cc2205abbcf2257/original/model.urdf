  <joint name="bottom_bracket_to_crank" type="continuous">
    <parent link="bottom_bracket" />
    <child link="crankset" />
    <axis xyz="1 0 0" />
    <limit effort="30" velocity="12" />
    </joint>
  <joint name="crank_to_drive_pedal" type="revolute">
    <origin xyz="0.107 0 -0.13" rpy="0 0 0" />
    <parent link="crankset" />
    <child link="drive_pedal" />
    <axis xyz="0 -1 0" />
    <limit effort="2" velocity="4" lower="0" upper="1.5708" />
    </joint>
  <joint name="crank_to_opposite_pedal" type="revolute">
    <origin xyz="-0.107 0 0.13" rpy="0 0 0" />
    <parent link="crankset" />
    <child link="opposite_pedal" />
    <axis xyz="0 -1 0" />
    <limit effort="2" velocity="4" lower="0" upper="1.5708" />
    </joint>
  </robot>
