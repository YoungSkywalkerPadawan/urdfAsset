  <joint name="base_to_bowl" type="prismatic">
    <origin xyz="0.102 0 0.096" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl" />
    <axis xyz="1 0 0" />
    <limit effort="20" velocity="0.06" lower="0" upper="0.032" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.123 0 0.286" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1.1" lower="0" upper="1.01229" />
    </joint>
  <joint name="head_to_tool" type="continuous">
