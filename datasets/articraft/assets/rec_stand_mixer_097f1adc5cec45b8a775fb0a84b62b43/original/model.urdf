  <joint name="pedestal_to_bowl_carriage" type="prismatic">
    <origin xyz="0.1 0 0.124" rpy="0 0 0" />
    <parent link="pedestal" />
    <child link="bowl_carriage" />
    <axis xyz="1 0 0" />
    <limit effort="70" velocity="0.12" lower="0" upper="0.065" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.045 0 0.018" rpy="0 0 0" />
    <parent link="bowl_carriage" />
    <child link="bowl" />
    </joint>
