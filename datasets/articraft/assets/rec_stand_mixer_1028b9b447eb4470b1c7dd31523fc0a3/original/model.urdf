  <joint name="body_to_bowl_stage" type="prismatic">
    <origin xyz="0.065 0 0.085" rpy="0 0 0" />
    <parent link="body" />
    <child link="bowl_stage" />
    <axis xyz="0 0 1" />
    <limit effort="120" velocity="0.06" lower="0" upper="0.05" />
    </joint>
  <joint name="stage_to_bowl" type="fixed">
    <origin xyz="0.19 0 0.018" rpy="0 0 0" />
    <parent link="bowl_stage" />
    <child link="bowl" />
    </joint>
  <joint name="body_to_head" type="revolute">
    <origin xyz="-0.12 0 0.34" rpy="0 0 0" />
    <parent link="body" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="80" velocity="1.8" lower="0" upper="1" />
    </joint>
  <joint name="head_to_whisk" type="continuous">
    <origin xyz="0.398 0 -0.022" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 -1" />
    <limit effort="15" velocity="22" />
    </joint>
  <joint name="body_to_speed_knob" type="revolute">
    <origin xyz="-0.03 0.088 0.215" rpy="0 0 0" />
    <parent link="body" />
    <child link="speed_knob" />
    <axis xyz="0 1 0" />
    <limit effort="2" velocity="4" lower="0" upper="1.2" />
    </joint>
  <joint name="body_to_head_lock" type="prismatic">
