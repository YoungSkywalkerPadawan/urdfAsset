  <joint name="base_to_bowl" type="prismatic">
    <origin xyz="0.07 0 0.082" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl" />
    <axis xyz="1 0 0" />
    <limit effort="65" velocity="0.18" lower="0" upper="0.06" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.18 0 0.43" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="35" velocity="0.8" lower="0" upper="0.65" />
    </joint>
  <joint name="head_to_whisk" type="continuous">
    <origin xyz="0.25 0 -0.095" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="45" />
    </joint>
  <joint name="base_to_speed_control" type="revolute">
    <origin xyz="-0.125 -0.11 0.235" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_control" />
    <axis xyz="0 1 0" />
    <limit effort="1" velocity="3" lower="-0.7" upper="0.7" />
    </joint>
  <joint name="base_to_head_lock" type="prismatic">
    <origin xyz="-0.215 0.11 0.285" rpy="0 0 0" />
    <parent link="base" />
    <child link="head_lock" />
    <axis xyz="0 -1 0" />
    <limit effort="6" velocity="0.06" lower="0" upper="0.012" />
    </joint>
  </robot>
