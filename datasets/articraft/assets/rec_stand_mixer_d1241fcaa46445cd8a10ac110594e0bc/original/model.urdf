  <joint name="base_to_bowl_slide" type="prismatic">
    <origin xyz="0.085 0 0" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl" />
    <axis xyz="1 0 0" />
    <limit effort="90" velocity="0.18" lower="0" upper="0.06" />
    </joint>
  <joint name="base_to_head_tilt" type="revolute">
    <origin xyz="-0.105 0 0.325" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="20" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_whisk_spin" type="continuous">
    <origin xyz="0.205 0 -0.081" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 1" />
    <limit effort="12" velocity="25" />
    </joint>
  <joint name="base_to_speed_dial" type="revolute">
    <origin xyz="-0.092 0.098 0.172" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_dial" />
    <axis xyz="0 1 0" />
    <limit effort="0.8" velocity="4" lower="-2.0944" upper="2.0944" />
    </joint>
  <joint name="base_to_lock_button" type="prismatic">
    <origin xyz="-0.112 -0.098 0.232" rpy="0 0 0" />
    <parent link="base" />
    <child link="lock_button" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="0.05" lower="0" upper="0.0035" />
    </joint>
  </robot>
