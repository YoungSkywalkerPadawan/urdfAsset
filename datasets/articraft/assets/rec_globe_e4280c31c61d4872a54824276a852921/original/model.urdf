  <joint name="collar_turn" type="continuous">
    <origin xyz="0 0 0.5" rpy="0 0 0" />
    <parent link="stand" />
    <child link="upper_support" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="1.5" />
    </joint>
  <joint name="globe_spin" type="continuous">
    <origin xyz="0 0 0.29" rpy="0 0 0" />
    <parent link="upper_support" />
    <child link="globe" />
    <axis xyz="0.398749 0 0.91706" />
    <limit effort="3" velocity="3" />
    </joint>
  </robot>
