  <link name="tonearm">
    <visual name="pivot_cap">
      <geometry>
        <cylinder radius="0.024" length="0.02" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.06 0.065 0.07 1" />
        </material>
      </visual>
    <visual name="arm_tube">
      <origin xyz="-0.107 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.006" length="0.214" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.7 0.66 1" />
        </material>
      </visual>
    <visual name="counterweight">
      <origin xyz="0.038 0 0.012" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.017" length="0.052" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.005 0.005 0.004 1" />
        </material>
      </visual>
    <visual name="headshell">
      <origin xyz="-0.226 0 -0.004" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.028 0.007" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.005 0.005 0.004 1" />
        </material>
      </visual>
    <visual name="stylus_tip">
      <origin xyz="-0.241 0 -0.019" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0022" length="0.024" />
        </geometry>
      <material name="ruby_stylus">
        <color rgba="0.65 0.02 0.03 1" />
        </material>
      </visual>
    </link>
  <joint name="platter_spin" type="continuous">
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="1.5" velocity="6" />
    </joint>
  <joint name="tonearm_pivot" type="revolute">
    <origin xyz="0.18 -0.105 0.15" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.35" velocity="1.2" lower="-0.48" upper="0.42" />
    </joint>
  </robot>
