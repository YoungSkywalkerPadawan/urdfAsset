  <joint name="support_to_meridian" type="revolute">
    <origin xyz="0 0 0.205" rpy="0 0 0" />
    <parent link="support" />
    <child link="meridian" />
    <axis xyz="1 0 0" />
    <limit effort="6" velocity="1.5" lower="-0.785398" upper="0.785398" />
    </joint>
  <joint name="meridian_to_globe" type="continuous">
    <parent link="meridian" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="3" />
    </joint>
  </robot>
