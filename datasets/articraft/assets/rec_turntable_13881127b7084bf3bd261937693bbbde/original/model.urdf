  <joint name="platter_spin" type="continuous">
    <origin xyz="0 0 0.078" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="12" />
    </joint>
  <joint name="tonearm_pivot" type="revolute">
    <origin xyz="0.155 -0.105 0.096" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.5" velocity="1.2" lower="-0.2" upper="0.95" />
    </joint>
  </robot>
