    <child link="downrod" />
    </joint>
  <joint name="fan_spin" type="continuous">
    <origin xyz="0 0 -0.32" rpy="0 0 0" />
    <parent link="downrod" />
    <child link="rotor_assembly" />
    <axis xyz="0 0 1" />
