  <link name="wheel">
    <visual name="front_tire">
      <geometry>
        <mesh filename="assets/meshes/front_tire.obj" />
        </geometry>
      <material name="black_rubber">
        <color rgba="0.01 0.01 0.01 1" />
        </material>
      </visual>
    <visual name="red_spoked_wheel">
      <geometry>
        <mesh filename="assets/meshes/red_spoked_wheel.obj" />
        </geometry>
      <material name="red_rim">
        <color rgba="0.65 0.05 0.03 1" />
        </material>
      </visual>
    <visual name="hub_bushing">
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.024" length="0.092" />
        </geometry>
      <material name="galvanized_steel">
        <color rgba="0.68 0.7 0.66 1" />
        </material>
      </visual>
    </link>
  <joint name="body_to_fork" type="fixed">
    <origin xyz="0 -0.72 0.23" rpy="0 0 0" />
    <parent link="upper_body" />
    <child link="fork" />
    </joint>
  <joint name="fork_to_axle" type="fixed">
    <parent link="fork" />
    <child link="axle" />
    </joint>
  <joint name="axle_to_wheel" type="continuous">
    <parent link="axle" />
    <child link="wheel" />
    <axis xyz="1 0 0" />
    <limit effort="12" velocity="18" />
    </joint>
  </robot>
