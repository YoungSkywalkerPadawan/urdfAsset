<robot name="premium_pencil_sharpener">
  <material name="body_finish">
    <color rgba="0.17 0.18 0.2 1" />
    </material>
  <material name="drawer_finish">
    <color rgba="0.12 0.13 0.15 1" />
    </material>
  <material name="trim_metal">
    <color rgba="0.77 0.79 0.82 1" />
    </material>
  <material name="dark_trim">
    <color rgba="0.08 0.08 0.09 1" />
    </material>
  <material name="grip_rubber">
    <color rgba="0.11 0.1 0.09 1" />
    </material>
  <link name="body">
    <visual name="body_shell">
      <geometry>
        <mesh filename="assets/meshes/sharpener_body.obj" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.17 0.18 0.2 1" />
        </material>
      </visual>
    <visual name="rear_band">
      <origin xyz="0 0.057 -0.046" rpy="0 0 0" />
      <geometry>
        <box size="0.132 0.004 0.01" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.08 0.08 0.09 1" />
        </material>
      </visual>
    <collision name="body_shell">
      <geometry>
        <mesh filename="assets/meshes/sharpener_body.obj" />
        </geometry>
      </collision>
    <collision name="rear_band">
      <origin xyz="0 0.057 -0.046" rpy="0 0 0" />
      <geometry>
        <box size="0.132 0.004 0.01" />
        </geometry>
      </collision>
    </link>
  <link name="drawer">
    <visual name="drawer_shell">
      <geometry>
        <mesh filename="assets/meshes/sharpener_drawer.obj" />
        </geometry>
      <material name="drawer_finish">
        <color rgba="0.12 0.13 0.15 1" />
        </material>
      </visual>
    <collision name="drawer_shell">
      <geometry>
        <mesh filename="assets/meshes/sharpener_drawer.obj" />
        </geometry>
      </collision>
    </link>
  <link name="dial">
    <visual name="dial_ring">
      <geometry>
        <mesh filename="assets/meshes/sharpener_dial.obj" />
        </geometry>
      <material name="trim_metal">
        <color rgba="0.77 0.79 0.82 1" />
        </material>
      </visual>
    <visual name="dial_pointer">
      <origin xyz="0 -0.0028 0.025" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.0056 0.006" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.08 0.08 0.09 1" />
        </material>
      </visual>
    <collision name="dial_ring">
      <geometry>
        <mesh filename="assets/meshes/sharpener_dial.obj" />
        </geometry>
      </collision>
    <collision name="dial_pointer">
      <origin xyz="0 -0.0028 0.025" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.0056 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="crank">
    <visual name="hub_cap">
      <origin xyz="0.004 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.023" length="0.008" />
        </geometry>
      <material name="trim_metal">
        <color rgba="0.77 0.79 0.82 1" />
        </material>
      </visual>
    <visual name="crank_arm">
      <origin xyz="0.004 0 0.023" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.01 0.046" />
        </geometry>
      <material name="trim_metal">
        <color rgba="0.77 0.79 0.82 1" />
        </material>
      </visual>
    <visual name="grip_shaft">
      <origin xyz="0.004 0.01 0.046" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.02 0.008" />
        </geometry>
      <material name="trim_metal">
        <color rgba="0.77 0.79 0.82 1" />
        </material>
      </visual>
    <visual name="handle_knob">
      <origin xyz="0.009 0.021 0.046" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0065" length="0.018" />
        </geometry>
      <material name="grip_rubber">
        <color rgba="0.11 0.1 0.09 1" />
        </material>
      </visual>
    <collision name="hub_cap">
      <origin xyz="0.004 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.023" length="0.008" />
        </geometry>
      </collision>
    <collision name="crank_arm">
      <origin xyz="0.004 0 0.023" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.01 0.046" />
        </geometry>
      </collision>
    <collision name="grip_shaft">
      <origin xyz="0.004 0.01 0.046" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.02 0.008" />
        </geometry>
      </collision>
    <collision name="handle_knob">
      <origin xyz="0.009 0.021 0.046" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0065" length="0.018" />
        </geometry>
      </collision>
    </link>
  <joint name="body_to_drawer" type="prismatic">
    <origin xyz="0 -0.059 -0.028" rpy="0 0 0" />
    <parent link="body" />
    <child link="drawer" />
    <axis xyz="0 -1 0" />
    <limit effort="30" velocity="0.2" lower="0" upper="0.055" />
    </joint>
  <joint name="body_to_dial" type="continuous">
    <origin xyz="0 -0.059 0.022" rpy="0 0 0" />
    <parent link="body" />
    <child link="dial" />
    <axis xyz="0 1 0" />
    <limit effort="3" velocity="6" />
    </joint>
  <joint name="body_to_crank" type="continuous">
    <origin xyz="0.095 0 0.006" rpy="0 0 0" />
    <parent link="body" />
    <child link="crank" />
    <axis xyz="1 0 0" />
    <limit effort="6" velocity="10" />
    </joint>
  </robot>
