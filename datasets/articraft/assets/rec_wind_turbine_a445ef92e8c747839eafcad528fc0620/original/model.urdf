  <joint name="base_to_bearing" type="fixed">
    <origin xyz="0 0 79.6" rpy="0 0 0" />
    <parent link="base" />
    <child link="bearing_module" />
    </joint>
  <joint name="yaw_rotation" type="continuous">
    <origin xyz="0 0 1.24" rpy="0 0 0" />
    <parent link="bearing_module" />
    <child link="head_module" />
    <axis xyz="0 0 1" />
    <limit effort="180000" velocity="0.3" />
    </joint>
  <joint name="rotor_spin" type="continuous">
    <origin xyz="10.4 0 3" rpy="0 0 0" />
    <parent link="head_module" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="240000" velocity="1.8" />
    </joint>
  </robot>
