      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="side_rail_1">
      <origin xyz="0.087 0 0.605" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.16 0.91" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="rear_spine">
      <origin xyz="0 0.074 0.6" rpy="0 0 0" />
      <geometry>
        <box size="0.154 0.018 0.9" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="corner_post_0">
      <origin xyz="-0.085 -0.063 0.605" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.91" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="corner_post_1">
      <origin xyz="0.085 -0.063 0.605" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.91" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="corner_post_2">
      <origin xyz="-0.085 0.063 0.605" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.91" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="corner_post_3">
      <origin xyz="0.085 0.063 0.605" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.017" length="0.91" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="front_grille">
      <origin xyz="0 -0.079 0.6" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/front_slot_grille.obj" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    <visual name="dial_recess_floor">
      <origin xyz="0 0 1.128" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.066" length="0.004" />
        </geometry>
      <material name="soft_gray">
        <color rgba="0.55 0.58 0.6 1" />
        </material>
      </visual>
    <visual name="dial_recess_rim">
      <origin xyz="0 0 1.132" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/dial_recess_rim.obj" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    </link>
  <link name="rotor">
    <visual name="blower_wheel">
      <geometry>
        <mesh filename="assets/meshes/vertical_blower_wheel.obj" />
        </geometry>
      <material name="translucent_blue">
        <color rgba="0.18 0.42 0.58 0.55" />
        </material>
      </visual>
    <visual name="rotor_shaft">
      <geometry>
        <cylinder radius="0.01" length="0.86" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    <visual name="rotor_hub">
      <geometry>
        <cylinder radius="0.03" length="0.08" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    </link>
  <link name="dial">
    <visual name="dial_cap">
      <geometry>
        <mesh filename="assets/meshes/selector_dial.obj" />
        </geometry>
      <material name="soft_gray">
        <color rgba="0.55 0.58 0.6 1" />
        </material>
      </visual>
    <visual name="dial_shaft">
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.012" length="0.07" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_tower" type="revolute">
    <origin xyz="0 0 0.115" rpy="0 0 0" />
    <parent link="base" />
    <child link="tower" />
    <axis xyz="0 0 1" />
    <limit effort="18" velocity="1.2" lower="-1.2" upper="1.2" />
    </joint>
  <joint name="tower_to_rotor" type="continuous">
    <origin xyz="0 0 0.585" rpy="0 0 0" />
    <parent link="tower" />
    <child link="rotor" />
    <axis xyz="0 0 1" />
    <limit effort="0.7" velocity="55" />
    </joint>
  <joint name="tower_to_dial" type="continuous">
    <origin xyz="0 0 1.13" rpy="0 0 0" />
    <parent link="tower" />
    <child link="dial" />
    <axis xyz="0 0 1" />
    <limit effort="0.35" velocity="8" />
    </joint>
  </robot>
