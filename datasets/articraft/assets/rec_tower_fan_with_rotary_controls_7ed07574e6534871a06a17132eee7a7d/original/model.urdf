<robot name="pedestal_tower_fan">
  <material name="satin_black">
    <color rgba="0.015 0.016 0.018 1" />
    </material>
  <material name="dark_plastic">
    <color rgba="0.045 0.048 0.052 1" />
    </material>
  <material name="graphite">
    <color rgba="0.18 0.19 0.2 1" />
    </material>
  <material name="soft_gray">
    <color rgba="0.55 0.58 0.6 1" />
    </material>
  <material name="translucent_blue">
    <color rgba="0.18 0.42 0.58 0.55" />
    </material>
  <link name="base">
    <visual name="weighted_disc">
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.27" length="0.06" />
        </geometry>
      <material name="satin_black">
        <color rgba="0.015 0.016 0.018 1" />
        </material>
      </visual>
    <visual name="base_collar">
      <origin xyz="0 0 0.0875" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.105" length="0.055" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.045 0.048 0.052 1" />
        </material>
      </visual>
    <visual name="trim_ring">
