      <geometry>
        <cylinder radius="0.122" length="0.01" />
        </geometry>
      <material name="graphite">
        <color rgba="0.18 0.19 0.2 1" />
        </material>
      </visual>
    </link>
  <link name="tower">
    <visual name="pivot_stem">
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
