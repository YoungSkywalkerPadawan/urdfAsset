  <joint name="base_to_carriage" type="prismatic">
    <origin xyz="0.035 0 0.06" rpy="0 0 0" />
    <parent link="base" />
    <child link="carriage" />
    <axis xyz="1 0 0" />
    <limit effort="40" velocity="0.08" lower="0" upper="0.026" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.082 0 0.018" rpy="0 0 0" />
    <parent link="carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.055 0 0.315" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1.2" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_paddle_drive" type="continuous">
    <origin xyz="0.172 0 -0.052" rpy="0 0 0" />
    <parent link="head" />
    <child link="paddle" />
    <axis xyz="0 0 1" />
    <limit effort="3" velocity="12" />
