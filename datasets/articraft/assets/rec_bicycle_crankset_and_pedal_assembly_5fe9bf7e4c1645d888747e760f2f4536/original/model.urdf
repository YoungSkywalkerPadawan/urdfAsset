  <joint name="bb_to_spindle" type="continuous">
    <parent link="bb_shell" />
    <child link="spindle" />
    <axis xyz="1 0 0" />
    <limit effort="180" velocity="30" />
    </joint>
  <joint name="spindle_to_right_crank" type="fixed">
    <origin xyz="0.065 0 0" rpy="0 0 0" />
    <parent link="spindle" />
    <child link="right_crank" />
    </joint>
  <joint name="spindle_to_left_crank" type="fixed">
    <origin xyz="-0.065 0 0" rpy="3.14159 0 0" />
    <parent link="spindle" />
    <child link="left_crank" />
    </joint>
  <joint name="right_crank_to_pedal_axle" type="fixed">
    <origin xyz="0.045 0 -0.17" rpy="0 0 0" />
    <parent link="right_crank" />
    <child link="right_pedal_axle" />
    </joint>
  <joint name="left_crank_to_pedal_axle" type="fixed">
    <origin xyz="-0.045 0 -0.17" rpy="0 0 0" />
    <parent link="left_crank" />
    <child link="left_pedal_axle" />
    </joint>
  <joint name="right_pedal_spin" type="continuous">
    <parent link="right_pedal_axle" />
    <child link="right_pedal" />
    <axis xyz="1 0 0" />
    <limit effort="6" velocity="35" />
    </joint>
  <joint name="left_pedal_spin" type="continuous">
    <parent link="left_pedal_axle" />
    <child link="left_pedal" />
    <axis xyz="1 0 0" />
    <limit effort="6" velocity="35" />
    </joint>
  </robot>
