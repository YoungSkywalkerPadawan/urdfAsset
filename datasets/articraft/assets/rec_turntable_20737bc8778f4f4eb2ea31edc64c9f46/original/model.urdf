    <axis xyz="0 0 1" />
    <limit effort="0.6" velocity="12" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.19 -0.105 0.129" rpy="0 0 1.98673" />
