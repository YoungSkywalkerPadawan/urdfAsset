  <joint name="platter_spin" type="continuous">
    <origin xyz="0 0 0.0505" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="15" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.198 -0.1 0.0825" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="1.5" velocity="1.5" lower="0" upper="1.22" />
    </joint>
  </robot>
