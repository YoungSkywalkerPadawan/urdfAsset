  <joint name="base_to_column" type="prismatic">
    <origin xyz="0 0.06 0.35" rpy="0 0 0" />
    <parent link="base" />
    <child link="column" />
    <axis xyz="0 0 1" />
    <limit effort="300" velocity="0.12" lower="0" upper="0.18" />
    </joint>
  <joint name="column_to_head" type="fixed">
    <origin xyz="0 -0.033 0.3" rpy="0 0 0" />
    <parent link="column" />
    <child link="head" />
    </joint>
  <joint name="head_to_quill" type="prismatic">
    <origin xyz="0 -0.102 0" rpy="0 0 0" />
    <parent link="head" />
    <child link="quill" />
    <axis xyz="0 0 -1" />
    <limit effort="120" velocity="0.18" lower="0" upper="0.12" />
    </joint>
  <joint name="head_to_feed_handle" type="continuous">
    <origin xyz="0.07 -0.102 0" rpy="0 0 0" />
    <parent link="head" />
    <child link="feed_handle" />
    <axis xyz="1 0 0" />
    <limit effort="5" velocity="8" />
    </joint>
  <joint name="base_to_magnet_button" type="prismatic">
    <origin xyz="-0.035 -0.114 0.088" rpy="0 0 0" />
    <parent link="base" />
    <child link="magnet_button" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="0.03" lower="0" upper="0.006" />
    </joint>
  <joint name="base_to_power_button" type="prismatic">
    <origin xyz="0.035 -0.114 0.088" rpy="0 0 0" />
    <parent link="base" />
    <child link="power_button" />
    <axis xyz="0 1 0" />
    <limit effort="8" velocity="0.03" lower="0" upper="0.006" />
    </joint>
