<robot name="wheelbarrow">
  <link name="tray">
    <visual>
      <geometry>
        <mesh filename="assets/meshes/tray_mesh.obj" />
        </geometry>
      </visual>
    </link>
  <link name="frame">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/frame_mesh.obj" />
        </geometry>
      </visual>
    </link>
  <link name="front_wheel">
    <visual>
      <geometry>
        <mesh filename="assets/meshes/wheel_mesh.obj" />
        </geometry>
      </visual>
    </link>
  <joint name="tray_to_frame" type="fixed">
    <parent link="tray" />
    <child link="frame" />
    </joint>
  <joint name="wheel_joint" type="continuous">
    <origin xyz="0.7 0 -0.02" rpy="0 0 0" />
    <parent link="frame" />
    <child link="front_wheel" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="5" />
    </joint>
  </robot>
