  <joint name="base_swivel" type="continuous">
    <origin xyz="0 0 0.089" rpy="0 0 0" />
    <parent link="base" />
    <child link="turntable" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="3" />
    </joint>
  <joint name="globe_spin" type="continuous">
    <origin xyz="0 0 0.92" rpy="0 0.410152 0" />
    <parent link="turntable" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="6" />
    </joint>
