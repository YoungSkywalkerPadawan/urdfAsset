      </visual>
    <visual name="axle_spindle">
      <origin xyz="0 -0.03 0.26" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.06" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.12 0.13 0.14 1" />
