        </geometry>
      <material name="satin_steel">
        <color rgba="0.58 0.61 0.66 1" />
        </material>
      </visual>
    </link>
  <link name="propeller">
    <inertial>
      <origin xyz="0 0.028 0" rpy="1.5708 0 0" />
      <mass value="0.65" />
      <inertia ixx="0.00806" ixy="0" ixz="0" iyy="0.00806" iyz="0" izz="0.01573" />
      </inertial>
    <visual name="blade_pack">
      <geometry>
        <mesh filename="assets/meshes/fan_propeller_blades.obj" />
        </geometry>
      <material name="translucent_blade">
        <color rgba="0.78 0.84 0.9 0.72" />
        </material>
      </visual>
    <visual name="hub">
      <origin xyz="0 0.028 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.048" length="0.056" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="hub_cap">
      <origin xyz="0 0.046 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.028" length="0.02" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.18 0.19 0.21 1" />
        </material>
      </visual>
    </link>
  <link name="timer_knob">
    <inertial>
      <origin xyz="0 -0.014 0" rpy="1.5708 0 0" />
      <mass value="0.04" />
      <inertia ixx="8.09333e-06" ixy="0" ixz="0" iyy="8.09333e-06" iyz="0" izz="1.352e-05" />
      </inertial>
    <visual name="knob_face">
      <origin xyz="0 -0.004 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.026" length="0.008" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.18 0.19 0.21 1" />
        </material>
      </visual>
    <visual name="knob_shaft">
      <origin xyz="0 -0.008 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.016" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="knob_body">
      <origin xyz="0 -0.019 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.022" length="0.022" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="indicator">
      <origin xyz="0.015 -0.016 0" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.012 0.0025" />
        </geometry>
      <material name="light_plastic">
        <color rgba="0.76 0.78 0.8 1" />
        </material>
      </visual>
    </link>
  <joint name="column_extension" type="prismatic">
    <origin xyz="0 0 0.06" rpy="0 0 0" />
    <parent link="base" />
    <child link="telescoping_column" />
    <axis xyz="0 0 1" />
    <limit effort="40" velocity="0.15" lower="0" upper="0.18" />
    </joint>
  <joint name="column_to_housing" type="fixed">
    <origin xyz="0 0 0.58" rpy="0 0 0" />
    <parent link="telescoping_column" />
    <child link="housing" />
    </joint>
  <joint name="housing_to_front_grille" type="fixed">
    <parent link="housing" />
    <child link="front_grille" />
    </joint>
  <joint name="fan_spin" type="continuous">
    <origin xyz="0 0 0.26" rpy="0 0 0" />
    <parent link="housing" />
    <child link="propeller" />
    <axis xyz="0 1 0" />
    <limit effort="5" velocity="25" />
    </joint>
  <joint name="timer_turn" type="revolute">
    <origin xyz="0 -0.204 0.26" rpy="0 0 0" />
    <parent link="housing" />
    <child link="timer_knob" />
    <axis xyz="0 1 0" />
    <limit effort="0.3" velocity="2" lower="0" upper="4.6" />
    </joint>
  </robot>
