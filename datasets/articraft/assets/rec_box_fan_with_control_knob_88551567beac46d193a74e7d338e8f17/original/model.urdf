  <link name="front_grille">
    <inertial>
      <origin xyz="0 0.08 0.26" rpy="0 0 0" />
      <mass value="0.55" />
      <inertia ixx="0.00704953" ixy="0" ixz="0" iyy="0.0140859" iyz="0" izz="0.00704953" />
      </inertial>
    <visual name="front_grille">
