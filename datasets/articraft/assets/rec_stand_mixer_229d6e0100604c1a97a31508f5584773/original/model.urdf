    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_hook" type="continuous">
    <origin xyz="0.245 0 -0.068" rpy="0 0 0" />
    <parent link="head" />
    <child link="hook" />
    <axis xyz="0 0 -1" />
    <limit effort="5" velocity="25" />
