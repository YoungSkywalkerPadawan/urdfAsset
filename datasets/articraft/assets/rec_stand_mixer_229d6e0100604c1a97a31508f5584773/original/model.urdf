  <joint name="base_to_carriage" type="prismatic">
    <origin xyz="0.025 0 0.06" rpy="0 0 0" />
    <parent link="base" />
    <child link="carriage" />
    <axis xyz="1 0 0" />
    <limit effort="35" velocity="0.1" lower="0" upper="0.05" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.145 0 0.099" rpy="0 0 0" />
    <parent link="carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
