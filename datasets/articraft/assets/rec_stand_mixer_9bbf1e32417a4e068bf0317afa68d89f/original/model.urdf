<robot name="streamlined_stand_mixer">
  <material name="body_enamel">
    <color rgba="0.93 0.93 0.9 1" />
    </material>
  <material name="stainless">
    <color rgba="0.86 0.88 0.9 1" />
    </material>
  <material name="dark_trim">
    <color rgba="0.12 0.12 0.13 1" />
    </material>
  <link name="base">
    <inertial>
      <origin xyz="0.01 0 0.175" rpy="0 0 0" />
      <mass value="7.6" />
      <inertia ixx="0.102917" ixy="0" ixz="0" iyy="0.138447" iyz="0" izz="0.0861967" />
      </inertial>
    <visual name="base_shell">
      <geometry>
        <mesh filename="assets/meshes/mixer_base_shell.obj" />
        </geometry>
      <material name="body_enamel">
        <color rgba="0.93 0.93 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="bowl_carriage">
    <inertial>
      <origin xyz="0.054 0 0.07" rpy="0 0 0" />
      <mass value="1.2" />
      <inertia ixx="0.00485" ixy="0" ixz="0" iyy="0.00452" iyz="0" izz="0.00545" />
      </inertial>
    <visual name="bowl_shell">
      <geometry>
        <mesh filename="assets/meshes/bowl_carriage_shell.obj" />
        </geometry>
      <material name="stainless">
        <color rgba="0.86 0.88 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="head">
    <inertial>
      <origin xyz="0.12 0 -0.02" rpy="0 0 0" />
      <mass value="3.9" />
      <inertia ixx="0.0138125" ixy="0" ixz="0" iyy="0.02704" iyz="0" izz="0.0242125" />
      </inertial>
    <visual name="head_shell">
      <geometry>
        <mesh filename="assets/meshes/mixer_head_shell.obj" />
        </geometry>
      <material name="body_enamel">
        <color rgba="0.93 0.93 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="whisk">
    <inertial>
      <origin xyz="0 0 -0.075" rpy="0 0 0" />
      <mass value="0.18" />
      <inertia ixx="0.000428625" ixy="0" ixz="0" iyy="0.000428625" iyz="0" izz="0.00018225" />
      </inertial>
    <visual name="whisk_shell">
      <geometry>
        <mesh filename="assets/meshes/balloon_whisk.obj" />
        </geometry>
      <material name="stainless">
        <color rgba="0.86 0.88 0.9 1" />
        </material>
      </visual>
    </link>
  <link name="speed_control">
    <inertial>
      <origin xyz="0.02 0.009 0" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="2.9e-06" ixy="0" ixz="0" iyy="1.044e-05" iyz="0" izz="1.01e-05" />
      </inertial>
    <visual name="speed_hub">
      <origin xyz="0 0.004 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.007" length="0.008" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.12 0.12 0.13 1" />
        </material>
      </visual>
    <visual name="speed_handle">
      <origin xyz="0.02 0.01 0" rpy="0 0 0" />
      <geometry>
        <box size="0.036 0.008 0.01" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.12 0.12 0.13 1" />
        </material>
      </visual>
    </link>
  <link name="head_lock">
    <inertial>
      <origin xyz="0.01 0.004 0" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="6.1e-07" ixy="0" ixz="0" iyy="1.8e-06" iyz="0" izz="1.69e-06" />
      </inertial>
    <visual name="lock_button">
      <origin xyz="0.01 0.004 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.008 0.01" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.12 0.12 0.13 1" />
        </material>
      </visual>
    <visual name="lock_stem">
      <origin xyz="0.007 0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.014 0.004 0.006" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.12 0.12 0.13 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_bowl_slide" type="prismatic">
    <origin xyz="0.09 0 0.05" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_carriage" />
    <axis xyz="1 0 0" />
    <limit effort="30" velocity="0.08" lower="0" upper="0.032" />
    </joint>
  <joint name="base_to_head_tilt" type="revolute">
    <origin xyz="0.002 0 0.322" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1" lower="0" upper="1.01229" />
    </joint>
  <joint name="head_to_whisk_drive" type="continuous">
    <origin xyz="0.164 0 -0.098" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 -1" />
    <limit effort="8" velocity="25" />
    </joint>
  <joint name="base_to_speed_control" type="revolute">
    <origin xyz="-0.05 0.06 0.188" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_control" />
    <axis xyz="0 -1 0" />
    <limit effort="1" velocity="2" lower="-0.3" upper="0.75" />
    </joint>
  <joint name="base_to_head_lock" type="prismatic">
    <origin xyz="-0.075 0.058 0.282" rpy="0 0 0" />
    <parent link="base" />
    <child link="head_lock" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="0.04" lower="0" upper="0.012" />
    </joint>
  </robot>
