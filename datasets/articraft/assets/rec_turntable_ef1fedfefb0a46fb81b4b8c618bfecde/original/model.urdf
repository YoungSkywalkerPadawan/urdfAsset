    <axis xyz="0 0 1" />
    <limit effort="4" velocity="12" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.19 -0.085 0.228" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="1.2" lower="-0.42" upper="0.28" />
    </joint>
  </robot>
