  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="0 0 0.116" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="12" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.17 0.11 0.215" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="1.2" lower="-0.25" upper="0.65" />
    </joint>
  </robot>
