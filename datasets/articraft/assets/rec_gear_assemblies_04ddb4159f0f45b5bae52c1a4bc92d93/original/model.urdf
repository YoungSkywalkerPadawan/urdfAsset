    <parent link="base_frame" />
    <child link="idler_shaft" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="20" />
    <mimic joint="input_bearing_axis" multiplier="-1" />
    </joint>
  <joint name="output_bearing_axis" type="continuous">
