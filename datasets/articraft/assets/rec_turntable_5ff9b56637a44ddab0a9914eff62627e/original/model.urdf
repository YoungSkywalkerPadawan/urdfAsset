<robot name="record_turntable">
  <material name="satin_walnut">
    <color rgba="0.34 0.19 0.09 1" />
    </material>
  <material name="matte_black">
    <color rgba="0.015 0.015 0.014 1" />
    </material>
  <material name="soft_rubber">
    <color rgba="0.035 0.035 0.034 1" />
    </material>
  <material name="brushed_aluminum">
    <color rgba="0.72 0.72 0.68 1" />
    </material>
  <material name="dark_anodized_metal">
    <color rgba="0.12 0.13 0.14 1" />
    </material>
  <material name="diamond_tip">
    <color rgba="0.86 0.88 0.9 1" />
    </material>
  <material name="record_label_red">
    <color rgba="0.55 0.04 0.035 1" />
    </material>
  <link name="plinth">
    <visual name="plinth_body">
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/rounded_plinth.obj" />
        </geometry>
      <material name="satin_walnut">
        <color rgba="0.34 0.19 0.09 1" />
        </material>
      </visual>
    <visual name="front_shadow_gap">
      <origin xyz="0 -0.181 0.026" rpy="0 0 0" />
      <geometry>
        <box size="0.44 0.02 0.01" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.015 0.015 0.014 1" />
        </material>
      </visual>
    <visual name="center_support">
      <origin xyz="0 0 0.0575" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.036" length="0.035" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.72 0.68 1" />
        </material>
      </visual>
    <visual name="tonearm_base_foot">
      <origin xyz="0.18 0.105 0.044" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.044" length="0.01" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="tonearm_pedestal">
      <origin xyz="0.18 0.105 0.085" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.024" length="0.09" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.72 0.68 1" />
        </material>
      </visual>
    <visual name="pivot_bushing">
      <origin xyz="0.18 0.105 0.124" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.014" length="0.012" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.015 0.015 0.014 1" />
        </material>
      </visual>
    </link>
  <link name="platter">
    <visual name="platter_disc">
      <origin xyz="0 0 0.012" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.164" length="0.024" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.72 0.68 1" />
        </material>
      </visual>
    <visual name="rubber_mat">
      <origin xyz="0 0 0.0265" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.148" length="0.005" />
        </geometry>
      <material name="soft_rubber">
        <color rgba="0.035 0.035 0.034 1" />
        </material>
      </visual>
    <visual name="vinyl_record">
      <origin xyz="0 0 0.0305" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.136" length="0.003" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.015 0.015 0.014 1" />
        </material>
      </visual>
    <visual name="record_label">
      <origin xyz="0 0 0.03375" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.0035" />
        </geometry>
      <material name="record_label_red">
        <color rgba="0.55 0.04 0.035 1" />
        </material>
      </visual>
    <visual name="center_spindle">
      <origin xyz="0 0 0.039" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.007" length="0.01" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.72 0.68 1" />
        </material>
      </visual>
    </link>
  <link name="tonearm">
    <visual name="pivot_cap">
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.014" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="arm_tube">
      <origin xyz="-0.088 0 0.008" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0042" length="0.168" />
        </geometry>
      <material name="brushed_aluminum">
        <color rgba="0.72 0.72 0.68 1" />
        </material>
      </visual>
    <visual name="counterweight">
      <origin xyz="0.035 0 0.018" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.015" length="0.046" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="headshell_bracket">
      <origin xyz="-0.158 0 0.003" rpy="0 0 0" />
      <geometry>
        <box size="0.012 0.01 0.011" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="headshell">
      <origin xyz="-0.176 0 -0.001" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.024 0.005" />
        </geometry>
      <material name="dark_anodized_metal">
        <color rgba="0.12 0.13 0.14 1" />
        </material>
      </visual>
    <visual name="cartridge">
      <origin xyz="-0.187 0 -0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.019 0.014 0.014" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.015 0.015 0.014 1" />
        </material>
      </visual>
    <visual name="stylus">
      <origin xyz="-0.19 0 -0.019" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0011" length="0.006" />
        </geometry>
      <material name="diamond_tip">
        <color rgba="0.86 0.88 0.9 1" />
        </material>
      </visual>
    </link>
  <joint name="platter_spin" type="continuous">
    <origin xyz="0 0 0.075" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="4" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.18 0.105 0.13" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.7" velocity="1.2" lower="-0.25" upper="0.32" />
    </joint>
  </robot>
