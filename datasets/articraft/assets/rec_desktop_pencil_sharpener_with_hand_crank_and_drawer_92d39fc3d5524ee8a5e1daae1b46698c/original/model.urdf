  <joint name="body_to_drawer" type="prismatic">
    <origin xyz="0 -0.072 0" rpy="0 0 0" />
    <parent link="body" />
    <child link="drawer" />
    <axis xyz="0 -1 0" />
    <limit effort="25" velocity="0.18" lower="0" upper="0.052" />
    </joint>
  <joint name="body_to_crank_hub" type="continuous">
    <origin xyz="0.109 0 0.07" rpy="0 0 0" />
    <parent link="body" />
    <child link="crank_hub" />
    <axis xyz="1 0 0" />
    <limit effort="3" velocity="8" />
    </joint>
  <joint name="hub_to_crank_arm" type="revolute">
    <origin xyz="0.025 0 -0.025" rpy="0 0 0" />
    <parent link="crank_hub" />
    <child link="crank_arm" />
    <axis xyz="0 -1 0" />
    <limit effort="2" velocity="2" lower="0" upper="1.35" />
    </joint>
  </robot>
