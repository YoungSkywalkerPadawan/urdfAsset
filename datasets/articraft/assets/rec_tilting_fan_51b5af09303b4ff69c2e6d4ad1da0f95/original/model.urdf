  <joint name="base_to_head_tilt" type="revolute">
    <origin xyz="0 0 0.8" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1.3" lower="-0.25" upper="0.55" />
    </joint>
  <joint name="head_to_front_guard" type="fixed">
    <parent link="head" />
    <child link="front_guard" />
    </joint>
  <joint name="head_to_rear_guard" type="fixed">
    <parent link="head" />
    <child link="rear_guard" />
    </joint>
  <joint name="head_to_rotor_spin" type="continuous">
    <origin xyz="0.19 0 0" rpy="0 0 0" />
    <parent link="head" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="2" velocity="35" />
    </joint>
  </robot>
