  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="-0.06 0.015 0.069" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="12" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.155 -0.105 0.125" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="1.5" velocity="2.5" lower="-0.15" upper="1.1" />
    </joint>
  </robot>
