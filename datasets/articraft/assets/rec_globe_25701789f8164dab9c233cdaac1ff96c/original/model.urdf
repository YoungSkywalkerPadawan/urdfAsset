  <joint name="base_to_cradle" type="continuous">
    <origin xyz="0 0 0.038" rpy="0 0 0" />
    <parent link="base" />
    <child link="cradle" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="1.5" />
    </joint>
  <joint name="cradle_to_globe" type="continuous">
    <origin xyz="0 0 0.205" rpy="0.410152 0 0" />
    <parent link="cradle" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="3" velocity="3" />
    </joint>
