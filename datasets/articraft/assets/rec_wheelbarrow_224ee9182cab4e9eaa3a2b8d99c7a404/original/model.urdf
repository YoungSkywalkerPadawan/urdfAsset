  <joint name="frame_to_tray" type="revolute">
    <origin xyz="0 0 0.03" rpy="0 0 0" />
    <parent link="frame" />
    <child link="tray" />
    <axis xyz="0 1 0" />
    <limit effort="18" velocity="1.5" lower="0" upper="1.25" />
    </joint>
  <joint name="frame_to_handles" type="revolute">
    <origin xyz="-0.06 0 0.02" rpy="0 0 0" />
    <parent link="frame" />
    <child link="handles" />
    <axis xyz="0 1 0" />
    <limit effort="12" velocity="1.8" lower="0" upper="1.35" />
    </joint>
  <joint name="handles_to_rear_legs" type="revolute">
    <origin xyz="-0.16 0 0.05" rpy="0 0 0" />
    <parent link="handles" />
    <child link="rear_legs" />
    <axis xyz="0 -1 0" />
    <limit effort="8" velocity="1.8" lower="0" upper="1.45" />
    </joint>
  <joint name="frame_to_fork" type="fixed">
    <origin xyz="0.145 0 0" rpy="0 0 0" />
    <parent link="frame" />
    <child link="fork" />
    </joint>
  <joint name="fork_to_wheel" type="continuous">
    <origin xyz="0.105 0 -0.015" rpy="0 0 0" />
    <parent link="fork" />
    <child link="wheel" />
    <axis xyz="0 1 0" />
    <limit effort="4" velocity="25" />
    </joint>
