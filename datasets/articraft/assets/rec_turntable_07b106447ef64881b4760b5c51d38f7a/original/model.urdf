  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="0 0 0.142" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2.5" velocity="18" />
    </joint>
  <joint name="platter_to_slip_mat" type="fixed">
    <parent link="platter" />
    <child link="slip_mat" />
    </joint>
  <joint name="plinth_to_tonearm_stage" type="revolute">
