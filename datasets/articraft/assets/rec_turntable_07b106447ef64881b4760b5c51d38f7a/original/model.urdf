    <parent link="plinth" />
    <child link="tonearm_stage" />
    <axis xyz="0 0 -1" />
    <limit effort="4" velocity="1.5" lower="0" upper="0.65" />
    </joint>
  <joint name="tonearm_to_cartridge" type="fixed">
    <origin xyz="0.226 0 0.007" rpy="0 0 0" />
    <parent link="tonearm_stage" />
    <child link="cartridge" />
    </joint>
