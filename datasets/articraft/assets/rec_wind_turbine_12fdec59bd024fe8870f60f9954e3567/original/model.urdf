  <joint name="tower_to_nacelle" type="continuous">
    <origin xyz="0 0 78.9" rpy="0 0 0" />
    <parent link="tower" />
    <child link="nacelle" />
    <axis xyz="0 0 1" />
    <limit effort="500000" velocity="0.2" />
    </joint>
  <joint name="nacelle_to_rotor" type="continuous">
    <origin xyz="6.4 0 3.35" rpy="0 0 0" />
    <parent link="nacelle" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="500000" velocity="1.5" />
    </joint>
  </robot>
