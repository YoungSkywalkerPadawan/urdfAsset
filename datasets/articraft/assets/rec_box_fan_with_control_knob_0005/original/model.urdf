  <joint name="grille_mount" type="fixed">
    <origin xyz="0 0.056 0" rpy="0 0 0" />
    <parent link="housing" />
    <child link="front_grille" />
    </joint>
  <joint name="blade_spin" type="continuous">
    <parent link="housing" />
    <child link="rotor" />
    <axis xyz="0 1 0" />
    <limit effort="3" velocity="22" />
    </joint>
  <joint name="speed_control" type="continuous">
    <origin xyz="0.218 0 -0.1" rpy="0 0 0" />
