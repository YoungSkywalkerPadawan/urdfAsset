  <joint name="yaw" type="continuous">
    <origin xyz="0 0 90" rpy="0 0 0" />
    <parent link="tower" />
    <child link="nacelle" />
    <axis xyz="0 0 1" />
    <limit effort="7.5e+06" velocity="0.18" />
    </joint>
  <joint name="rotor_spin" type="continuous">
    <origin xyz="7.8 0 2.65" rpy="0 0 0" />
    <parent link="nacelle" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="3e+06" velocity="2.5" />
    </joint>
  </robot>
