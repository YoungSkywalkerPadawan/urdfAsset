  <joint name="shell_to_spindle" type="continuous">
    <parent link="bottom_bracket_shell" />
    <child link="spindle" />
    <axis xyz="0 0 1" />
    <limit effort="90" velocity="25" />
    </joint>
  <joint name="spindle_to_drive_crank" type="fixed">
    <parent link="spindle" />
    <child link="drive_crank" />
    </joint>
  <joint name="spindle_to_left_crank" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.14159" />
    <parent link="spindle" />
    <child link="left_crank" />
    </joint>
  <joint name="spindle_to_chainring" type="fixed">
    <origin xyz="0 0 0.0512" rpy="0 0 0" />
    <parent link="spindle" />
    <child link="chainring" />
    </joint>
  <joint name="drive_crank_to_right_pedal" type="continuous">
    <origin xyz="0.175 0 0.063" rpy="0 0 0" />
    <parent link="drive_crank" />
    <child link="right_pedal" />
    <axis xyz="0 0 1" />
    <limit effort="15" velocity="30" />
    </joint>
  <joint name="left_crank_to_left_pedal" type="continuous">
    <origin xyz="0.175 0 -0.063" rpy="0 0 0" />
    <parent link="left_crank" />
    <child link="left_pedal" />
    <axis xyz="0 0 1" />
    <limit effort="15" velocity="30" />
    </joint>
  </robot>
