    </link>
  <joint name="platter_spin" type="continuous">
    <origin xyz="-0.03 0 0.04" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="12" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.155 0.087 0.064" rpy="0 0 -1.18" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 -1" />
    <limit effort="3" velocity="2" lower="0" upper="1.35" />
    </joint>
  </robot>
