  <joint name="base_to_bowl_slide" type="prismatic">
    <origin xyz="0.218 0 0.056" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl" />
    <axis xyz="1 0 0" />
    <limit effort="45" velocity="0.1" lower="0" upper="0.055" />
    </joint>
  <joint name="base_to_head_hinge" type="revolute">
    <origin xyz="0.012 0 0.293" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1" lower="0" upper="1.01229" />
    </joint>
  <joint name="head_to_whisk_spin" type="continuous">
