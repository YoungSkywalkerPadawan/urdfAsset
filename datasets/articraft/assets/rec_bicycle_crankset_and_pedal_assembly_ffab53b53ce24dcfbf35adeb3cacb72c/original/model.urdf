  <joint name="shell_to_spindle" type="continuous">
    <parent link="bottom_bracket_shell" />
    <child link="spindle" />
    <axis xyz="0 -1 0" />
    <limit effort="120" velocity="18" />
    </joint>
  <joint name="spindle_to_right_crank" type="fixed">
    <parent link="spindle" />
    <child link="right_crank" />
    </joint>
  <joint name="spindle_to_left_crank" type="fixed">
    <parent link="spindle" />
    <child link="left_crank" />
    </joint>
  <joint name="right_pedal_spin" type="continuous">
    <origin xyz="0.17 -0.067 0" rpy="0 0 0" />
    <parent link="right_crank" />
    <child link="right_pedal" />
    <axis xyz="0 -1 0" />
    <limit effort="10" velocity="25" />
    </joint>
  <joint name="left_pedal_spin" type="continuous">
    <origin xyz="-0.17 0.067 0" rpy="0 0 0" />
    <parent link="left_crank" />
    <child link="left_pedal" />
    <axis xyz="0 1 0" />
