  <joint name="main_rotor_spin" type="continuous">
    <origin xyz="-0.02 0 2.35" rpy="0 0 0" />
    <parent link="airframe" />
    <child link="main_rotor" />
    <axis xyz="0 0 1" />
    <limit effort="120" velocity="40" />
    </joint>
  <joint name="tail_rotor_spin" type="continuous">
    <origin xyz="-3.86 0.445 1.44" rpy="0 0 0" />
    <parent link="airframe" />
    <child link="tail_rotor" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="70" />
    </joint>
  <joint name="left_cowling_hinge" type="revolute">
    <origin xyz="-0.5 0.54 1.72" rpy="0 0 0" />
    <parent link="airframe" />
    <child link="left_cowling_door" />
    <axis xyz="1 0 0" />
    <limit effort="18" velocity="1.8" lower="0" upper="1.8326" />
    </joint>
  <joint name="right_cowling_hinge" type="revolute">
    <origin xyz="-0.5 -0.54 1.72" rpy="0 0 0" />
    <parent link="airframe" />
    <child link="right_cowling_door" />
    <axis xyz="-1 0 0" />
    <limit effort="18" velocity="1.8" lower="0" upper="1.8326" />
    </joint>
  </robot>
