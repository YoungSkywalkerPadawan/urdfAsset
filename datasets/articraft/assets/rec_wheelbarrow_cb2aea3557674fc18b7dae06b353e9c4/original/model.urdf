    </link>
  <joint name="tray_mount" type="fixed">
    <origin xyz="0 0.09 0.38" rpy="0 0 0" />
    <parent link="frame" />
    <child link="tray" />
    </joint>
  <joint name="front_wheel_spin" type="continuous">
    <origin xyz="0 0.64 0.2" rpy="0 0 0" />
    <parent link="frame" />
    <child link="front_wheel" />
    <axis xyz="1 0 0" />
    <limit effort="18" velocity="30" />
    </joint>
  </robot>
