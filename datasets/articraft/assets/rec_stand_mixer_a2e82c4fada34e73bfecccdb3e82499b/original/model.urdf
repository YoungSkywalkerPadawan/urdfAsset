  <joint name="base_to_bowl_carriage" type="prismatic">
    <origin xyz="0.072 0 0.057" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_carriage" />
    <axis xyz="1 0 0" />
    <limit effort="25" velocity="0.08" lower="0" upper="0.026" />
    </joint>
  <joint name="base_to_speed_knob" type="revolute">
    <origin xyz="0.02 0.0775 0.054" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_knob" />
    <axis xyz="0 1 0" />
    <limit effort="1" velocity="3" lower="0" upper="1.45" />
    </joint>
  <joint name="base_to_head_lock" type="prismatic">
    <origin xyz="-0.083 0.047 0.329" rpy="0 0 0" />
    <parent link="base" />
    <child link="head_lock" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="0.05" lower="0" upper="0.006" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0 0 0.028" rpy="0 0 0" />
    <parent link="bowl_carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.085 0 0.324" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1" lower="0" upper="1.01229" />
    </joint>
  <joint name="head_to_beater" type="continuous">
    <origin xyz="0.156 0 -0.06" rpy="0 0 0" />
    <parent link="head" />
    <child link="beater" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="20" />
    </joint>
  </robot>
