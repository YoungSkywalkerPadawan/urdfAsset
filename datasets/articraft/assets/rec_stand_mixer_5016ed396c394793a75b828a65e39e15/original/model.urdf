  <joint name="base_to_bowl_stage" type="prismatic">
    <origin xyz="0.005 0 0.068" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_stage" />
    <axis xyz="1 0 0" />
    <limit effort="60" velocity="0.08" lower="0" upper="0.04" />
    </joint>
  <joint name="stage_to_bowl" type="fixed">
    <origin xyz="0.09 0 0.054" rpy="0 0 0" />
    <parent link="bowl_stage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.105 0 0.315" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="20" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="base_to_speed_lever" type="revolute">
