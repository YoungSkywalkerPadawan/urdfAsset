  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="0 0 0.048" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="20" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.165 0.102 0.073" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 -1" />
    <limit effort="1" velocity="1.5" lower="0" upper="1.15" />
    </joint>
  <joint name="plinth_to_guard_frame" type="fixed">
    <parent link="plinth" />
    <child link="guard_frame" />
    </joint>
