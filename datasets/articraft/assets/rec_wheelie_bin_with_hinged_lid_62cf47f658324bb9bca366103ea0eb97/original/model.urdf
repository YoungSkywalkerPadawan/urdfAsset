  <joint name="bin_body_to_wheel_0" type="continuous">
    <origin xyz="-0.315 -0.365 0.155" rpy="0 0 0" />
    <parent link="bin_body" />
    <child link="wheel_0" />
    <axis xyz="0 1 0" />
    <limit effort="4" velocity="20" />
    </joint>
  <joint name="bin_body_to_wheel_1" type="continuous">
    <origin xyz="-0.315 0.365 0.155" rpy="0 0 0" />
