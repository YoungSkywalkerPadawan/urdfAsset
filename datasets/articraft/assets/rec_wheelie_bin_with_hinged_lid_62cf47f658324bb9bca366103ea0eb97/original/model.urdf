    </joint>
  <joint name="bin_body_to_lid" type="revolute">
    <origin xyz="-0.41 0 1.065" rpy="0 0 0" />
    <parent link="bin_body" />
    <child link="lid" />
    <axis xyz="0 -1 0" />
    <limit effort="12" velocity="2" lower="0" upper="1.85" />
    </joint>
  </robot>
