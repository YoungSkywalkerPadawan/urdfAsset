    <child link="nacelle" />
    <axis xyz="0 0 1" />
    <limit effort="8000" velocity="0.35" />
    </joint>
  <joint name="nacelle_to_rotor_spin" type="continuous">
    <origin xyz="3.62 0 1.1" rpy="0 0 0" />
