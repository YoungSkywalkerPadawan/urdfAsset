<robot name="tilting_fan">
  <material name="dark_plastic">
    <color rgba="0.16 0.17 0.18 1" />
    </material>
  <material name="medium_plastic">
    <color rgba="0.24 0.25 0.27 1" />
    </material>
  <material name="steel">
    <color rgba="0.75 0.77 0.8 1" />
    </material>
  <material name="blade_gray">
    <color rgba="0.7 0.72 0.74 0.92" />
    </material>
  <link name="base">
    <visual name="base_shell">
      <origin xyz="0 0 0.014" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/fan_base_shell.obj" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <visual name="stem">
      <origin xyz="-0.035 0 0.123" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.19" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <visual name="yoke_bridge">
      <origin xyz="-0.052 0 0.227" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.34 0.018" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <visual name="left_arm">
      <origin xyz="-0.027 0.173 0.26" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.014 0.084" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <visual name="right_arm">
      <origin xyz="-0.027 -0.173 0.26" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.014 0.084" />
        </geometry>
      <material name="dark_plastic">
        <color rgba="0.16 0.17 0.18 1" />
        </material>
      </visual>
    <visual name="left_yoke_pad">
      <origin xyz="-0.008 0.166 0.26" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.012" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="right_yoke_pad">
      <origin xyz="-0.008 -0.166 0.26" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.012" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    </link>
  <link name="head">
    <visual name="housing_shell">
      <origin xyz="0.048 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/fan_head_shell.obj" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="left_pivot_bracket">
      <origin xyz="0.021 0.101 0" rpy="0 0 0" />
      <geometry>
        <box size="0.058 0.106 0.05" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="right_pivot_bracket">
      <origin xyz="0.021 -0.101 0" rpy="0 0 0" />
      <geometry>
        <box size="0.058 0.106 0.05" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="left_trunnion">
      <origin xyz="0 0.149 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.022" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="right_trunnion">
      <origin xyz="0 -0.149 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.022" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="nose_flange">
      <origin xyz="0.052 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.032" length="0.016" />
        </geometry>
      <material name="medium_plastic">
        <color rgba="0.24 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="shaft_stub">
      <origin xyz="0.067 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.008" length="0.014" />
        </geometry>
      <material name="steel">
        <color rgba="0.75 0.77 0.8 1" />
        </material>
      </visual>
    <visual name="guard_cage">
      <geometry>
        <mesh filename="assets/meshes/fan_guard_cage.obj" />
        </geometry>
      <material name="steel">
        <color rgba="0.75 0.77 0.8 1" />
        </material>
      </visual>
    </link>
  <link name="rotor">
    <visual name="hub_shell">
      <origin xyz="0.009 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.034" length="0.018" />
        </geometry>
      <material name="blade_gray">
        <color rgba="0.7 0.72 0.74 0.92" />
        </material>
      </visual>
    <visual name="blade_set">
      <geometry>
        <mesh filename="assets/meshes/fan_blade_set.obj" />
        </geometry>
      <material name="blade_gray">
        <color rgba="0.7 0.72 0.74 0.92" />
        </material>
      </visual>
    </link>
  <joint name="base_to_head_tilt" type="revolute">
    <origin xyz="-0.008 0 0.26" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="8" velocity="1.5" lower="-0.436332" upper="0.698132" />
    </joint>
  <joint name="head_to_rotor_spin" type="continuous">
    <origin xyz="0.074 0 0" rpy="0 0 0" />
    <parent link="head" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="2.5" velocity="25" />
    </joint>
  </robot>
