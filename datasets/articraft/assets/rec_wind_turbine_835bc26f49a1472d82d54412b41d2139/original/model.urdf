<robot name="premium_consumer_wind_turbine">
  <material name="painted_metal">
    <color rgba="0.86 0.88 0.9 1" />
    </material>
  <material name="hub_metal">
    <color rgba="0.46 0.49 0.53 1" />
    </material>
  <material name="polymer_shell">
    <color rgba="0.95 0.96 0.97 1" />
    </material>
  <material name="elastomer">
    <color rgba="0.14 0.15 0.16 1" />
    </material>
  <material name="base_metal">
    <color rgba="0.34 0.36 0.39 1" />
    </material>
  <link name="tower">
    <inertial>
      <origin xyz="0 0 4" rpy="0 0 0" />
      <mass value="240" />
      <inertia ixx="1282.4" ixy="0" ixz="0" iyy="1282.4" iyz="0" izz="4.8" />
      </inertial>
    <visual name="tower_shell">
      <geometry>
        <mesh filename="assets/meshes/tower_shell.obj" />
        </geometry>
      <material name="painted_metal">
        <color rgba="0.86 0.88 0.9 1" />
        </material>
      </visual>
    <visual name="tower_base_flange">
      <origin xyz="0 0 0.04" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.275" length="0.08" />
        </geometry>
      <material name="base_metal">
        <color rgba="0.34 0.36 0.39 1" />
        </material>
      </visual>
    <visual name="tower_top_flange">
      <origin xyz="0 0 7.95" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.116" length="0.1" />
        </geometry>
      <material name="base_metal">
        <color rgba="0.34 0.36 0.39 1" />
        </material>
      </visual>
    </link>
  <link name="nacelle">
    <inertial>
      <origin xyz="0.1 0 0.27" rpy="0 1.5708 0" />
      <mass value="95" />
      <inertia ixx="8.4455" ixy="0" ixz="0" iyy="8.4455" iyz="0" izz="2.299" />
      </inertial>
    <visual name="nacelle_shell">
      <geometry>
        <mesh filename="assets/meshes/nacelle_shell.obj" />
        </geometry>
      <material name="painted_metal">
        <color rgba="0.86 0.88 0.9 1" />
        </material>
      </visual>
    <visual name="tower_mount">
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.116" length="0.12" />
        </geometry>
      <material name="hub_metal">
        <color rgba="0.46 0.49 0.53 1" />
        </material>
      </visual>
    <visual name="front_bearing_face">
      <origin xyz="0.49 0 0.26" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.108" length="0.14" />
        </geometry>
      <material name="hub_metal">
        <color rgba="0.46 0.49 0.53 1" />
        </material>
      </visual>
    </link>
  <link name="rotor">
    <inertial>
      <origin xyz="0.18 0 0" rpy="0 1.5708 0" />
      <mass value="28" />
      <inertia ixx="6.81123" ixy="0" ixz="0" iyy="6.81123" iyz="0" izz="12.635" />
      </inertial>
    <visual name="rear_bearing_collar">
      <origin xyz="0.03 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.12" length="0.06" />
        </geometry>
      <material name="hub_metal">
        <color rgba="0.46 0.49 0.53 1" />
        </material>
      </visual>
    <visual name="hub_shell">
      <geometry>
        <mesh filename="assets/meshes/hub_shell.obj" />
        </geometry>
      <material name="hub_metal">
        <color rgba="0.46 0.49 0.53 1" />
        </material>
      </visual>
    <visual name="spinner_cap">
      <geometry>
        <mesh filename="assets/meshes/spinner_cap.obj" />
        </geometry>
      <material name="polymer_shell">
        <color rgba="0.95 0.96 0.97 1" />
        </material>
      </visual>
    <visual name="blade_set">
      <geometry>
        <mesh filename="assets/meshes/blade_set.obj" />
        </geometry>
      <material name="polymer_shell">
        <color rgba="0.95 0.96 0.97 1" />
        </material>
      </visual>
    <visual name="blade_root_boots">
      <geometry>
        <mesh filename="assets/meshes/blade_root_boots.obj" />
        </geometry>
      <material name="elastomer">
        <color rgba="0.14 0.15 0.16 1" />
        </material>
      </visual>
    </link>
  <joint name="tower_to_nacelle" type="fixed">
    <origin xyz="0 0 8" rpy="0 0 0" />
    <parent link="tower" />
    <child link="nacelle" />
    </joint>
  <joint name="nacelle_to_rotor" type="continuous">
    <origin xyz="0.56 0 0.26" rpy="0 0 0" />
    <parent link="nacelle" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="32" velocity="2.8" />
    </joint>
  </robot>
