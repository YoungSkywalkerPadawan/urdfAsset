  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="0 0 0.068" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="12" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.16 0.092 0.098" rpy="0 0 -1.25" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
