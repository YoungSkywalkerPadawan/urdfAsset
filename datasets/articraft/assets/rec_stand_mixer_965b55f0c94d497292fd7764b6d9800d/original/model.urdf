  <joint name="base_to_bowl" type="prismatic">
    <origin xyz="0.072 0 0.03" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl" />
    <axis xyz="1 0 0" />
    <limit effort="25" velocity="0.1" lower="0" upper="0.035" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.074 0 0.212" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="20" velocity="1.2" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_beater" type="continuous">
    <origin xyz="0.15 0 -0.06" rpy="0 0 0" />
    <parent link="head" />
    <child link="beater" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="18" />
    </joint>
  <joint name="base_to_speed_control" type="revolute">
