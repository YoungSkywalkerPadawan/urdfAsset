  <link name="blower_wheel">
    <visual name="blower_cage">
      <geometry>
        <mesh filename="assets/meshes/blower_wheel.obj" />
        </geometry>
      <material name="smoked_rotor">
        <color rgba="0.22 0.25 0.27 1" />
        </material>
      </visual>
    <visual name="blower_shaft">
      <geometry>
        <cylinder radius="0.012" length="0.775" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="blower_hub">
      <geometry>
        <cylinder radius="0.028" length="0.06" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    </link>
  <link name="speed_knob">
    <visual name="shaft">
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.018" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="knurled_cap">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/speed_knob_cap.obj" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.01 0.012 0.014 1" />
        </material>
      </visual>
    </link>
  <link name="timer_knob">
    <visual name="shaft">
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.018" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="knurled_cap">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/timer_knob_cap.obj" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.01 0.012 0.014 1" />
        </material>
      </visual>
    </link>
  <joint name="pedestal_to_body" type="revolute">
    <origin xyz="0 0 0.195" rpy="0 0 0" />
    <parent link="pedestal" />
    <child link="body" />
    <axis xyz="0 0 1" />
    <limit effort="12" velocity="0.7" lower="-0.85" upper="0.85" />
    </joint>
  <joint name="body_to_blower" type="continuous">
    <origin xyz="0 0 0.452" rpy="0 0 0" />
    <parent link="body" />
    <child link="blower_wheel" />
    <axis xyz="0 0 1" />
    <limit effort="3" velocity="70" />
    </joint>
  <joint name="body_to_speed_knob" type="revolute">
    <origin xyz="-0.04 -0.015 0.926" rpy="0 0 0" />
    <parent link="body" />
    <child link="speed_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="5" lower="-2.35" upper="2.35" />
    </joint>
  <joint name="body_to_timer_knob" type="revolute">
    <origin xyz="0.04 -0.015 0.926" rpy="0 0 0" />
    <parent link="body" />
    <child link="timer_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="5" lower="-2.35" upper="2.35" />
    </joint>
  </robot>
