      <geometry>
        <cylinder radius="0.064" length="0.032" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.86 0.86 0.8 1" />
        </material>
      </visual>
    <visual name="intake_grille">
      <origin xyz="0 -0.082 0.46" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/intake_grille.obj" />
        </geometry>
      <material name="dark_graphite">
        <color rgba="0.05 0.055 0.06 1" />
        </material>
      </visual>
    <visual name="control_deck">
      <origin xyz="0 -0.015 0.923" rpy="0 0 0" />
      <geometry>
        <box size="0.135 0.07 0.006" />
        </geometry>
      <material name="matte_black">
        <color rgba="0.01 0.012 0.014 1" />
        </material>
      </visual>
    <visual name="bottom_bearing">
      <origin xyz="0 0 0.065" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.025" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="top_bearing">
      <origin xyz="0 0 0.84" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.025" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="bearing_strut_0">
      <origin xyz="-0.025 0.039 0.84" rpy="0 0 0" />
      <geometry>
        <box size="0.022 0.068 0.014" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
      </visual>
    <visual name="bearing_strut_1">
      <origin xyz="0.025 0.039 0.84" rpy="0 0 0" />
      <geometry>
        <box size="0.022 0.068 0.014" />
        </geometry>
      <material name="brushed_metal">
        <color rgba="0.58 0.6 0.6 1" />
        </material>
