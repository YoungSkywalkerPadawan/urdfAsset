        </geometry>
      <material name="black_rubber">
        <color rgba="0.004 0.004 0.004 1" />
        </material>
      </visual>
    <visual name="pedestal_neck">
      <origin xyz="0 0 0.11" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.042" length="0.13" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.86 0.86 0.8 1" />
        </material>
      </visual>
    <visual name="turntable_collar">
      <origin xyz="0 0 0.1825" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.068" length="0.025" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.86 0.86 0.8 1" />
        </material>
      </visual>
    </link>
  <link name="body">
