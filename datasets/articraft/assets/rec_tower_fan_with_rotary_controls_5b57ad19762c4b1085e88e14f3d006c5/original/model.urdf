<robot name="modern_tower_fan">
  <material name="warm_white_plastic">
    <color rgba="0.86 0.86 0.8 1" />
    </material>
  <material name="dark_graphite">
    <color rgba="0.05 0.055 0.06 1" />
    </material>
  <material name="matte_black">
    <color rgba="0.01 0.012 0.014 1" />
    </material>
  <material name="black_rubber">
    <color rgba="0.004 0.004 0.004 1" />
    </material>
  <material name="brushed_metal">
    <color rgba="0.58 0.6 0.6 1" />
    </material>
  <material name="smoked_rotor">
    <color rgba="0.22 0.25 0.27 1" />
    </material>
  <link name="pedestal">
    <visual name="oval_foot">
      <origin xyz="0 0 0.0225" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.18" length="0.045" />
        </geometry>
      <material name="warm_white_plastic">
        <color rgba="0.86 0.86 0.8 1" />
        </material>
      </visual>
    <visual name="rubber_sole">
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
