<robot name="low_profile_spindle_shuttle">
  <material name="base_finish">
    <color rgba="0.22 0.24 0.27 1" />
    </material>
  <material name="rail_finish">
    <color rgba="0.72 0.74 0.78 1" />
    </material>
  <material name="carriage_finish">
    <color rgba="0.54 0.57 0.6 1" />
    </material>
  <material name="housing_finish">
    <color rgba="0.18 0.19 0.21 1" />
    </material>
  <material name="spindle_finish">
    <color rgba="0.83 0.84 0.86 1" />
    </material>
  <link name="base">
    <visual name="base_body">
      <geometry>
        <mesh filename="assets/meshes/base_body.obj" />
        </geometry>
      <material name="base_finish">
        <color rgba="0.22 0.24 0.27 1" />
        </material>
      </visual>
    <visual name="left_rail">
      <origin xyz="0 0.06 0.0225" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.028 0.011" />
        </geometry>
      <material name="rail_finish">
        <color rgba="0.72 0.74 0.78 1" />
        </material>
      </visual>
    <visual name="right_rail">
      <origin xyz="0 -0.06 0.0225" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.028 0.011" />
        </geometry>
      <material name="rail_finish">
        <color rgba="0.72 0.74 0.78 1" />
        </material>
      </visual>
    </link>
  <link name="carriage">
    <visual name="carriage_body">
      <geometry>
        <mesh filename="assets/meshes/carriage_body.obj" />
        </geometry>
      <material name="carriage_finish">
        <color rgba="0.54 0.57 0.6 1" />
        </material>
      </visual>
    <visual name="left_pad">
      <origin xyz="0 0.06 0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.024 0.009" />
        </geometry>
      <material name="rail_finish">
        <color rgba="0.72 0.74 0.78 1" />
        </material>
      </visual>
    <visual name="right_pad">
      <origin xyz="0 -0.06 0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.15 0.024 0.009" />
        </geometry>
      <material name="rail_finish">
        <color rgba="0.72 0.74 0.78 1" />
        </material>
      </visual>
    <visual name="mount_pad">
      <origin xyz="0.04 0 0.028" rpy="0 0 0" />
      <geometry>
        <box size="0.09 0.1 0.013" />
        </geometry>
      <material name="carriage_finish">
        <color rgba="0.54 0.57 0.6 1" />
        </material>
      </visual>
    </link>
  <link name="spindle_housing">
    <visual name="housing_body">
      <geometry>
        <mesh filename="assets/meshes/spindle_housing_body.obj" />
        </geometry>
      <material name="housing_finish">
        <color rgba="0.18 0.19 0.21 1" />
        </material>
      </visual>
    <visual name="mount_foot">
      <origin xyz="0 0 0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.1 0.009" />
        </geometry>
      <material name="housing_finish">
        <color rgba="0.18 0.19 0.21 1" />
        </material>
      </visual>
    </link>
  <link name="spindle">
    <visual name="spindle_body">
      <geometry>
        <mesh filename="assets/meshes/spindle_body.obj" />
        </geometry>
      <material name="spindle_finish">
        <color rgba="0.83 0.84 0.86 1" />
        </material>
      </visual>
    <visual name="index_lug">
      <origin xyz="0.01 0 0.027" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.008 0.012" />
        </geometry>
      <material name="spindle_finish">
        <color rgba="0.83 0.84 0.86 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_carriage" type="prismatic">
    <origin xyz="0 0 0.028" rpy="0 0 0" />
    <parent link="base" />
    <child link="carriage" />
    <axis xyz="1 0 0" />
    <limit effort="120" velocity="0.45" lower="-0.17" upper="0.17" />
    </joint>
  <joint name="carriage_to_spindle_housing" type="fixed">
    <origin xyz="0.04 0 0.034" rpy="0 0 0" />
    <parent link="carriage" />
    <child link="spindle_housing" />
    </joint>
  <joint name="housing_to_spindle" type="continuous">
    <origin xyz="0.052 0 0.031" rpy="0 0 0" />
    <parent link="spindle_housing" />
    <child link="spindle" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="25" />
    </joint>
  </robot>
