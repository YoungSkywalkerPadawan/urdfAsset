  <link name="control_knob">
    <visual name="knob_cap">
      <geometry>
        <mesh filename="assets/meshes/side_control_knob.obj" />
        </geometry>
      <material name="black_knob">
        <color rgba="0.02 0.02 0.018 1" />
        </material>
      </visual>
    </link>
  <joint name="housing_to_fan" type="continuous">
    <origin xyz="0 0.105 0" rpy="-1.5708 0 0" />
    <parent link="wall_housing" />
    <child link="fan_rotor" />
    <axis xyz="0 0 1" />
    <limit effort="12" velocity="45" />
    </joint>
  <joint name="housing_to_flap" type="revolute">
    <origin xyz="0 0.194 0.31" rpy="0 0 0" />
    <parent link="wall_housing" />
    <child link="damper_flap" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="1.6" lower="0" upper="1.25" />
    </joint>
  <joint name="housing_to_knob" type="continuous">
    <origin xyz="0.374 0.105 -0.165" rpy="0 1.5708 0" />
    <parent link="wall_housing" />
    <child link="control_knob" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="8" />
    </joint>
  </robot>
