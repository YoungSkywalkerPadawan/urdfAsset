  <link name="fan_rotor">
    <visual name="rotor">
      <geometry>
        <mesh filename="assets/meshes/six_blade_rotor.obj" />
        </geometry>
      <material name="dark_blades">
        <color rgba="0.12 0.14 0.15 1" />
        </material>
      </visual>
    <visual name="shaft_stub">
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.016" length="0.05" />
        </geometry>
      <material name="dark_steel">
        <color rgba="0.08 0.09 0.1 1" />
        </material>
      </visual>
    </link>
  <link name="damper_flap">
    <visual name="flap_panel">
      <origin xyz="0 0.007 -0.28" rpy="0 0 0" />
      <geometry>
        <box size="0.6 0.014 0.56" />
        </geometry>
      <material name="galvanized_steel">
        <color rgba="0.58 0.62 0.64 1" />
        </material>
      </visual>
    <visual name="flap_hinge_barrel">
      <origin xyz="0 0.007 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.011" length="0.63" />
        </geometry>
      <material name="dark_steel">
        <color rgba="0.08 0.09 0.1 1" />
