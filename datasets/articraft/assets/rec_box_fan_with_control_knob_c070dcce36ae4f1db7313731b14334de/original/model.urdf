    <visual name="stiffening_rib">
      <origin xyz="0 0.016 -0.045" rpy="0 0 0" />
      <geometry>
        <box size="0.56 0.006 0.03" />
        </geometry>
      <material name="dark_steel">
        <color rgba="0.08 0.09 0.1 1" />
        </material>
      </visual>
