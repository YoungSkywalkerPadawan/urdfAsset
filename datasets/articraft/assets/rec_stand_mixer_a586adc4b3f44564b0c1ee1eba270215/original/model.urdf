<robot name="artisan_tilt_head_stand_mixer">
  <material name="body_red">
    <color rgba="0.72 0.1 0.12 1" />
    </material>
  <material name="polished_steel">
    <color rgba="0.92 0.92 0.94 1" />
    </material>
  <material name="dark_trim">
    <color rgba="0.11 0.11 0.12 1" />
    </material>
  <material name="satin_steel">
    <color rgba="0.74 0.76 0.78 1" />
    </material>
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.17" rpy="0 0 0" />
      <mass value="10.5" />
      <inertia ixx="0.16975" ixy="0" ixz="0" iyy="0.24115" iyz="0" izz="0.2086" />
      </inertial>
    <visual name="base_plate">
      <origin xyz="0.02 0 0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/base_plate.obj" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="pedestal_shell">
      <origin xyz="-0.145 0 0.17" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/pedestal_shell.obj" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="carriage_deck">
      <origin xyz="0.055 0 0.064" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.13 0.028" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="hinge_block">
      <origin xyz="-0.075 0 0.29" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.136 0.04" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="left_hinge_cheek">
      <origin xyz="-0.043 0.074 0.314" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.012 0.04" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="right_hinge_cheek">
      <origin xyz="-0.043 -0.074 0.314" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.012 0.04" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    </link>
  <link name="bowl_carriage">
    <inertial>
      <origin xyz="0.01 0 0.04" rpy="0 0 0" />
      <mass value="1.2" />
      <inertia ixx="0.00164" ixy="0" ixz="0" iyy="0.0026" iyz="0" izz="0.00296" />
      </inertial>
    <visual name="slide_block">
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.13 0.095 0.03" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="bowl_saddle">
      <origin xyz="-0.035 0 0.037" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.06 0.014" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="mount_plate">
      <origin xyz="0.02 0 0.034" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.008" />
        </geometry>
      <material name="satin_steel">
        <color rgba="0.74 0.76 0.78 1" />
        </material>
      </visual>
    </link>
  <link name="bowl">
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0" />
      <mass value="1.4" />
      <inertia ixx="0.0092834" ixy="0" ixz="0" iyy="0.0092834" iyz="0" izz="0.0094192" />
      </inertial>
    <visual name="bowl_shell">
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/mixing_bowl_shell.obj" />
        </geometry>
      <material name="polished_steel">
        <color rgba="0.92 0.92 0.94 1" />
        </material>
      </visual>
    <visual name="bowl_foot">
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.014" />
        </geometry>
      <material name="polished_steel">
        <color rgba="0.92 0.92 0.94 1" />
        </material>
      </visual>
    </link>
  <link name="head">
    <inertial>
      <origin xyz="0.19 0 -0.005" rpy="0 0 0" />
      <mass value="4.4" />
      <inertia ixx="0.0264733" ixy="0" ixz="0" iyy="0.0607567" iyz="0" izz="0.0607567" />
      </inertial>
    <visual name="head_shell">
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/head_shell.obj" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="hinge_barrel">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.013" length="0.136" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="hinge_bridge">
      <origin xyz="0.038 0 -0.006" rpy="0 0 0" />
      <geometry>
        <box size="0.056 0.1 0.032" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="drive_nose">
      <origin xyz="0.25 0 0.004" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.028" length="0.08" />
        </geometry>
      <material name="body_red">
        <color rgba="0.72 0.1 0.12 1" />
        </material>
      </visual>
    <visual name="planetary_hub">
      <origin xyz="0.172 0 -0.039" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.016" length="0.032" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.11 0.11 0.12 1" />
        </material>
      </visual>
    </link>
  <link name="whisk">
    <inertial>
      <origin xyz="0 0 -0.061" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.000523975" ixy="0" ixz="0" iyy="0.000523975" iyz="0" izz="0.00030375" />
      </inertial>
    <visual name="whisk_shell">
      <geometry>
        <mesh filename="assets/meshes/balloon_whisk.obj" />
        </geometry>
      <material name="polished_steel">
        <color rgba="0.92 0.92 0.94 1" />
        </material>
      </visual>
    <visual name="whisk_coupler">
      <origin xyz="0 0 -0.013" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.012" length="0.026" />
        </geometry>
      <material name="satin_steel">
        <color rgba="0.74 0.76 0.78 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_bowl_carriage" type="prismatic">
    <origin xyz="0.09 0 0.078" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_carriage" />
    <axis xyz="1 0 0" />
    <limit effort="80" velocity="0.08" lower="0" upper="0.035" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.038 0 0.036" rpy="0 0 0" />
    <parent link="bowl_carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.04 0 0.314" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1.1" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_whisk" type="continuous">
    <origin xyz="0.172 0 -0.055" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="20" />
    </joint>
  </robot>
