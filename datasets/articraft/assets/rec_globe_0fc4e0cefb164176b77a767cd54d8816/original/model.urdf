  <joint name="cradle_to_inner" type="revolute">
    <origin xyz="0 0 0.62" rpy="0 0 0" />
    <parent link="outer_cradle" />
    <child link="inner_ring" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="1.2" lower="-0.9" upper="0.9" />
    </joint>
  <joint name="inner_to_globe" type="continuous">
    <parent link="inner_ring" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="2.5" />
    </joint>
  </robot>
