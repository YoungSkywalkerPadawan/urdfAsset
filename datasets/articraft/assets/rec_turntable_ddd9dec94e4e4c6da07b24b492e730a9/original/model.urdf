  <joint name="platter_spin" type="continuous">
    <origin xyz="-0.04 0 0.062" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="0.6" velocity="6" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.148 -0.095 0.088" rpy="0 0 1.35" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.8" velocity="1.5" lower="0" upper="1.1" />
    </joint>
  </robot>
