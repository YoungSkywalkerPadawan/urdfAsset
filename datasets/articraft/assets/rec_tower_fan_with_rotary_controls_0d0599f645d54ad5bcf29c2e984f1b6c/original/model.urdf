      <origin xyz="0 0 0.008" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.014" length="0.008" />
        </geometry>
      <material name="satin_gray_controls">
        <color rgba="0.36 0.37 0.36 1" />
        </material>
      </visual>
    <visual name="button_stem">
      <origin xyz="0 0 -0.003" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.014" />
        </geometry>
      <material name="satin_gray_controls">
        <color rgba="0.36 0.37 0.36 1" />
        </material>
      </visual>
    <visual name="button_mark">
      <origin xyz="0.002 0 0.0122" rpy="0 0 0" />
      <geometry>
        <box size="0.014 0.0022 0.0008" />
        </geometry>
      <material name="white_control_marks">
        <color rgba="0.94 0.94 0.88 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_body" type="revolute">
    <origin xyz="0 0 0.058" rpy="0 0 0" />
    <parent link="base" />
    <child link="body" />
    <axis xyz="0 0 1" />
    <limit effort="18" velocity="0.8" lower="-0.75" upper="0.75" />
    </joint>
  <joint name="body_to_impeller" type="continuous">
    <origin xyz="0 0 0.56" rpy="0 0 0" />
    <parent link="body" />
    <child link="impeller" />
    <axis xyz="0 0 1" />
    <limit effort="3" velocity="70" />
    </joint>
  <joint name="body_to_power_knob" type="continuous">
    <origin xyz="0 -0.04 1.035" rpy="0 0 0" />
    <parent link="body" />
    <child link="power_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="4" />
    </joint>
  <joint name="body_to_timer_knob" type="continuous">
    <origin xyz="0 0.034 1.035" rpy="0 0 0" />
    <parent link="body" />
    <child link="timer_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.4" velocity="4" />
    </joint>
  <joint name="body_to_oscillation_button" type="prismatic">
    <origin xyz="-0.038 0.071 1.035" rpy="0 0 0" />
    <parent link="body" />
    <child link="oscillation_button" />
    <axis xyz="0 0 -1" />
    <limit effort="1" velocity="0.08" lower="0" upper="0.006" />
    </joint>
  </robot>
