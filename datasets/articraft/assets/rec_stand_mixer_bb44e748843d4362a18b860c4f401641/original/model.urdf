  <joint name="base_to_bowl_carriage" type="prismatic">
    <origin xyz="0.035 0 0.044" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_carriage" />
    <axis xyz="1 0 0" />
    <limit effort="90" velocity="0.1" lower="0" upper="0.045" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0.08 0 0.035" rpy="0 0 0" />
    <parent link="bowl_carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.09 0 0.247" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="20" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="head_to_whisk" type="continuous">
    <origin xyz="0.205 0 0" rpy="0 0 0" />
    <parent link="head" />
    <child link="whisk" />
    <axis xyz="0 0 -1" />
    <limit effort="8" velocity="18" />
    </joint>
  <joint name="base_to_speed_selector" type="revolute">
    <origin xyz="0.055 0.115 0.03" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_selector" />
    <axis xyz="0 1 0" />
    <limit effort="1.2" velocity="1.6" lower="-0.75" upper="0.75" />
    </joint>
  <joint name="base_to_lock_control" type="prismatic">
