  <joint name="tower_to_hub" type="fixed">
    <origin xyz="0 1.35 10.95" rpy="0 0 0" />
    <parent link="tower" />
    <child link="clock_hub" />
    </joint>
  <joint name="hub_to_hour_hand" type="continuous">
    <origin xyz="0 0.024 0" rpy="0 0 0" />
    <parent link="clock_hub" />
    <child link="hour_hand" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="1" />
    </joint>
  <joint name="hub_to_minute_hand" type="continuous">
    <origin xyz="0 0.038 0" rpy="0 0 0" />
    <parent link="clock_hub" />
    <child link="minute_hand" />
    <axis xyz="0 1 0" />
    <limit effort="20" velocity="6" />
    </joint>
  </robot>
