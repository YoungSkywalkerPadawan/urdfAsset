<robot name="power_clamp_meter">
  <material name="shell_charcoal">
    <color rgba="0.19 0.2 0.21 1" />
    </material>
  <material name="jaw_black">
    <color rgba="0.11 0.12 0.13 1" />
    </material>
  <material name="trim_dark">
    <color rgba="0.15 0.16 0.17 1" />
    </material>
  <material name="button_grey">
    <color rgba="0.28 0.29 0.31 1" />
    </material>
  <material name="display_glass">
    <color rgba="0.2 0.32 0.36 0.45" />
    </material>
  <material name="stand_dark">
    <color rgba="0.12 0.12 0.13 1" />
    </material>
  <link name="body">
    <visual name="shell">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_body.obj" />
        </geometry>
      <material name="shell_charcoal">
        <color rgba="0.19 0.2 0.21 1" />
        </material>
      </visual>
    <collision name="shell">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_body.obj" />
        </geometry>
      </collision>
    </link>
  <link name="jaw">
    <visual name="jaw_arc">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_jaw.obj" />
        </geometry>
      <material name="jaw_black">
        <color rgba="0.11 0.12 0.13 1" />
        </material>
      </visual>
    <collision name="jaw_arc">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_jaw.obj" />
        </geometry>
      </collision>
    </link>
  <link name="selector_knob">
    <visual name="knob">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_selector_knob.obj" />
        </geometry>
      <material name="trim_dark">
        <color rgba="0.15 0.16 0.17 1" />
        </material>
      </visual>
    <collision name="knob">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_selector_knob.obj" />
        </geometry>
      </collision>
    </link>
  <link name="mode_button_0">
    <visual name="button_cap">
      <origin xyz="0 0.00125 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.0025 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <visual name="button_stem">
      <origin xyz="0 -0.003 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.006 0.006" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <collision name="button_cap">
      <origin xyz="0 0.00125 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.0025 0.01" />
        </geometry>
      </collision>
    <collision name="button_stem">
      <origin xyz="0 -0.003 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.006 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="mode_button_1">
    <visual name="button_cap">
      <origin xyz="0 0.00125 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.0025 0.01" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <visual name="button_stem">
      <origin xyz="0 -0.003 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.006 0.006" />
        </geometry>
      <material name="button_grey">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <collision name="button_cap">
      <origin xyz="0 0.00125 0" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.0025 0.01" />
        </geometry>
      </collision>
    <collision name="button_stem">
      <origin xyz="0 -0.003 0" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.006 0.006" />
        </geometry>
      </collision>
    </link>
  <link name="display">
    <visual name="display_glass">
      <origin xyz="0 0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.062 0.004 0.042" />
        </geometry>
      <material name="display_glass">
        <color rgba="0.2 0.32 0.36 0.45" />
        </material>
      </visual>
    <collision name="display_glass">
      <origin xyz="0 0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.062 0.004 0.042" />
        </geometry>
      </collision>
    </link>
  <link name="kickstand">
    <visual name="stand_panel">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_kickstand.obj" />
        </geometry>
      <material name="stand_dark">
        <color rgba="0.12 0.12 0.13 1" />
        </material>
      </visual>
    <collision name="stand_panel">
      <geometry>
        <mesh filename="assets/meshes/clamp_meter_kickstand.obj" />
        </geometry>
      </collision>
    </link>
  <joint name="body_to_jaw" type="revolute">
    <origin xyz="-0.046 0 0.155" rpy="0 0 0" />
    <parent link="body" />
    <child link="jaw" />
    <axis xyz="0 -1 0" />
    <limit effort="20" velocity="2.2" lower="0" upper="1.18" />
    </joint>
  <joint name="body_to_selector_knob" type="continuous">
    <origin xyz="0 0.03 -0.038" rpy="0 0 0" />
    <parent link="body" />
    <child link="selector_knob" />
    <axis xyz="0 1 0" />
    <limit effort="0.8" velocity="8" />
    </joint>
  <joint name="body_to_mode_button_0" type="prismatic">
    <origin xyz="-0.018 0.03 0.014" rpy="0 0 0" />
    <parent link="body" />
    <child link="mode_button_0" />
    <axis xyz="0 -1 0" />
    <limit effort="12" velocity="0.08" lower="0" upper="0.0018" />
    </joint>
  <joint name="body_to_mode_button_1" type="prismatic">
    <origin xyz="0.018 0.03 0.014" rpy="0 0 0" />
    <parent link="body" />
    <child link="mode_button_1" />
    <axis xyz="0 -1 0" />
    <limit effort="12" velocity="0.08" lower="0" upper="0.0018" />
    </joint>
  <joint name="body_to_display" type="fixed">
    <origin xyz="0 0.024 0.06" rpy="0 0 0" />
    <parent link="body" />
    <child link="display" />
    </joint>
  <joint name="body_to_kickstand" type="revolute">
    <origin xyz="0 -0.03 -0.072" rpy="0 0 0" />
    <parent link="body" />
    <child link="kickstand" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="1.5" lower="0" upper="1.15" />
    </joint>
  </robot>
