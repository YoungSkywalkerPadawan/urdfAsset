  <joint name="plinth_to_platter" type="continuous">
    <origin xyz="-0.07 0.025 0.225" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="20" />
    </joint>
  <joint name="plinth_to_tonearm" type="revolute">
    <origin xyz="0.205 -0.128 0.267" rpy="0 0 2.73" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="1.2" velocity="1.4" lower="-0.55" upper="0.18" />
    </joint>
  </robot>
