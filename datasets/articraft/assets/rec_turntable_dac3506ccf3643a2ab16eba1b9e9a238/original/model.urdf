    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="8" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.145 0.11 0.088" rpy="0 0 -2.64474" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="0.6" velocity="2" lower="-0.35" upper="0.38" />
    </joint>
  </robot>
