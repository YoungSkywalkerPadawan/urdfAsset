<robot name="minimalist_canted_globe">
  <material name="graphite">
    <color rgba="0.16 0.17 0.19 1" />
    </material>
  <material name="charcoal">
    <color rgba="0.22 0.23 0.25 1" />
    </material>
  <material name="satin_metal">
    <color rgba="0.7 0.72 0.75 1" />
    </material>
  <material name="brass">
    <color rgba="0.73 0.6 0.32 1" />
    </material>
  <material name="globe_blue">
    <color rgba="0.18 0.39 0.63 1" />
    </material>
  <link name="base_ring">
    <inertial>
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <mass value="2.8" />
      <inertia ixx="0.0168632" ixy="0" ixz="0" iyy="0.0168632" iyz="0" izz="0.033635" />
      </inertial>
    <visual name="outer_ring">
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/base_ring_plate.obj" />
        </geometry>
      <material name="graphite">
        <color rgba="0.16 0.17 0.19 1" />
        </material>
      </visual>
    <visual name="center_hub">
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.052" length="0.014" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.25 1" />
        </material>
      </visual>
    <visual name="bridge_0">
      <origin xyz="0.055 0 0.007" rpy="0 0 0" />
      <geometry>
        <box size="0.11 0.014 0.014" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.25 1" />
        </material>
      </visual>
    <visual name="bridge_1">
      <origin xyz="-0.0275 0.0476314 0.007" rpy="0 0 2.0944" />
      <geometry>
        <box size="0.11 0.014 0.014" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.25 1" />
        </material>
      </visual>
    <visual name="bridge_2">
      <origin xyz="-0.0275 -0.0476314 0.007" rpy="0 0 4.18879" />
      <geometry>
        <box size="0.11 0.014 0.014" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.25 1" />
        </material>
      </visual>
    </link>
  <link name="support_pedestal">
    <inertial>
      <origin xyz="0.07 0 0.165" rpy="0 0 0" />
      <mass value="1.9" />
      <inertia ixx="0.0180183" ixy="0" ixz="0" iyy="0.0229583" iyz="0" izz="0.00649167" />
      </inertial>
    <visual name="turntable_platter">
      <origin xyz="0 0 0.019" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.043" length="0.01" />
        </geometry>
      <material name="charcoal">
        <color rgba="0.22 0.23 0.25 1" />
        </material>
      </visual>
    <visual name="pedestal_bridge">
      <origin xyz="0.068 0 0.032" rpy="0 0 0" />
      <geometry>
        <box size="0.136 0.016 0.016" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="vertical_mast">
      <origin xyz="0.136 0 0.134" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.22" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="upper_arm">
      <origin xyz="0.115 0 0.265" rpy="0 -0.785398 0" />
      <geometry>
        <cylinder radius="0.005" length="0.059397" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="head_arm">
      <origin xyz="0.0729187 0 0.305109" rpy="0 -0.834436 0" />
      <geometry>
        <cylinder radius="0.005" length="0.056906" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="spindle_knuckle">
      <origin xyz="0.0518374 0 0.324218" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.013" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="spindle_pin">
      <origin xyz="0.0496443 0 0.319174" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.006" length="0.011" />
        </geometry>
      <material name="satin_metal">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="retainer_disc">
      <origin xyz="0.046853 0 0.312755" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.018" length="0.003" />
        </geometry>
      <material name="brass">
        <color rgba="0.73 0.6 0.32 1" />
        </material>
      </visual>
    </link>
  <link name="globe">
    <inertial>
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <mass value="1.4" />
      <inertia ixx="0.0056" ixy="0" ixz="0" iyy="0.0056" iyz="0" izz="0.0056" />
      </inertial>
    <visual name="globe_shell">
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.1" />
        </geometry>
      <material name="globe_blue">
        <color rgba="0.18 0.39 0.63 1" />
        </material>
      </visual>
    <visual name="polar_hub">
      <origin xyz="0 0 0.008" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.014" length="0.016" />
        </geometry>
      <material name="brass">
        <color rgba="0.73 0.6 0.32 1" />
        </material>
      </visual>
    <visual name="equator_band">
      <origin xyz="0 0 -0.1" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/globe_equator_band.obj" />
        </geometry>
      <material name="brass">
        <color rgba="0.73 0.6 0.32 1" />
        </material>
      </visual>
    </link>
  <joint name="pedestal_turn" type="continuous">
    <parent link="base_ring" />
    <child link="support_pedestal" />
    <axis xyz="0 0 1" />
    <limit effort="8" velocity="3" />
    </joint>
  <joint name="globe_spin" type="continuous">
    <origin xyz="0.0398749 0 0.296706" rpy="0 0.410152 0" />
    <parent link="support_pedestal" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="2.5" velocity="8" />
    </joint>
  </robot>
