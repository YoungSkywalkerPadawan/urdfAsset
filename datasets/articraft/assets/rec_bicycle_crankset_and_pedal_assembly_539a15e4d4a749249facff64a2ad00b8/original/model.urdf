<robot name="gravel_one_by_crankset">
  <material name="forged_aluminum">
    <color rgba="0.28 0.29 0.31 1" />
    </material>
  <material name="dark_alloy">
    <color rgba="0.18 0.18 0.2 1" />
    </material>
  <material name="satin_steel">
    <color rgba="0.7 0.72 0.75 1" />
    </material>
  <material name="composite_black">
    <color rgba="0.1 0.11 0.12 1" />
    </material>
  <material name="ring_black">
    <color rgba="0.07 0.07 0.08 1" />
    </material>
  <link name="bottom_bracket_shell">
    <inertial>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <mass value="0.85" />
      <inertia ixx="0.000830946" ixy="0" ixz="0" iyy="0.000830946" iyz="0" izz="0.000462825" />
      </inertial>
    <visual name="shell">
      <geometry>
        <mesh filename="assets/meshes/bottom_bracket_shell.obj" />
        </geometry>
      <material name="dark_alloy">
        <color rgba="0.18 0.18 0.2 1" />
        </material>
      </visual>
    </link>
  <link name="crank_core">
    <inertial>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <mass value="0.6" />
      <inertia ixx="0.00054335" ixy="0" ixz="0" iyy="0.00054335" iyz="0" izz="8.67e-05" />
      </inertial>
    <visual name="spindle">
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.015" length="0.068" />
        </geometry>
      <material name="satin_steel">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="right_collar">
      <origin xyz="0.042 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0185" length="0.016" />
        </geometry>
      <material name="satin_steel">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    <visual name="left_collar">
      <origin xyz="-0.042 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.0185" length="0.016" />
        </geometry>
      <material name="satin_steel">
        <color rgba="0.7 0.72 0.75 1" />
        </material>
      </visual>
    </link>
  <link name="left_crank_arm">
    <inertial>
      <origin xyz="-0.012 0.004 -0.086" rpy="0 0 0" />
      <mass value="0.42" />
      <inertia ixx="0.001295" ixy="0" ixz="0" iyy="0.00128366" iyz="0" izz="5.166e-05" />
      </inertial>
    <visual name="arm_body">
      <geometry>
        <mesh filename="assets/meshes/left_crank_arm.obj" />
        </geometry>
      <material name="forged_aluminum">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    </link>
  <link name="right_crank_arm">
    <inertial>
      <origin xyz="0.008 0 -0.03" rpy="0 0 0" />
      <mass value="0.68" />
      <inertia ixx="0.00398508" ixy="0" ixz="0" iyy="0.00209667" iyz="0" izz="0.00199042" />
      </inertial>
    <visual name="arm_body">
      <geometry>
        <mesh filename="assets/meshes/right_crank_arm.obj" />
        </geometry>
      <material name="forged_aluminum">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <visual name="spider_mount">
      <origin xyz="0.012 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.028" length="0.018" />
        </geometry>
      <material name="forged_aluminum">
        <color rgba="0.28 0.29 0.31 1" />
        </material>
      </visual>
    <visual name="chainring">
      <geometry>
        <mesh filename="assets/meshes/oval_chainring.obj" />
        </geometry>
      <material name="ring_black">
        <color rgba="0.07 0.07 0.08 1" />
        </material>
      </visual>
    </link>
  <link name="left_pedal">
    <inertial>
      <origin xyz="-0.03 0 0" rpy="0 0 0" />
      <mass value="0.18" />
      <inertia ixx="0.00012876" ixy="0" ixz="0" iyy="9.15e-05" iyz="0" izz="0.00014526" />
      </inertial>
    <visual name="pedal_body">
      <geometry>
        <mesh filename="assets/meshes/left_pedal.obj" />
        </geometry>
      <material name="composite_black">
        <color rgba="0.1 0.11 0.12 1" />
        </material>
      </visual>
    </link>
  <link name="right_pedal">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <mass value="0.18" />
      <inertia ixx="0.00012876" ixy="0" ixz="0" iyy="9.15e-05" iyz="0" izz="0.00014526" />
      </inertial>
    <visual name="pedal_body">
      <geometry>
        <mesh filename="assets/meshes/right_pedal.obj" />
        </geometry>
      <material name="composite_black">
        <color rgba="0.1 0.11 0.12 1" />
        </material>
      </visual>
    </link>
  <joint name="shell_to_crank" type="continuous">
    <parent link="bottom_bracket_shell" />
    <child link="crank_core" />
    <axis xyz="1 0 0" />
    <limit effort="90" velocity="16" />
    </joint>
  <joint name="crank_to_left_arm" type="fixed">
    <origin xyz="-0.05 0 0" rpy="3.14159 0 0" />
    <parent link="crank_core" />
    <child link="left_crank_arm" />
    </joint>
  <joint name="crank_to_right_arm" type="fixed">
    <origin xyz="0.05 0 0" rpy="0 0 0" />
    <parent link="crank_core" />
    <child link="right_crank_arm" />
    </joint>
  <joint name="left_pedal_spin" type="continuous">
    <origin xyz="-0.024 0.012 -0.1725" rpy="0 0 0" />
    <parent link="left_crank_arm" />
    <child link="left_pedal" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="30" />
    </joint>
  <joint name="right_pedal_spin" type="continuous">
    <origin xyz="0.024 0.012 -0.1725" rpy="0 0 0" />
    <parent link="right_crank_arm" />
    <child link="right_pedal" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="30" />
    </joint>
  </robot>
