  <joint name="stand_to_meridian" type="fixed">
    <parent link="stand" />
    <child link="meridian" />
    </joint>
  <joint name="stand_to_date_supports" type="fixed">
    <parent link="stand" />
    <child link="date_supports" />
    </joint>
  <joint name="globe_spin" type="continuous">
    <origin xyz="0 0 0.205" rpy="0 0 0" />
    <parent link="stand" />
    <child link="globe" />
    <axis xyz="0.398749 0 0.91706" />
    <limit effort="3" velocity="3.5" />
    </joint>
  <joint name="date_ring_spin" type="continuous">
    <origin xyz="0 0 0.205" rpy="0 0 0" />
    <parent link="stand" />
    <child link="date_ring" />
    <axis xyz="0 1 0" />
    <limit effort="1" velocity="2" />
    </joint>
