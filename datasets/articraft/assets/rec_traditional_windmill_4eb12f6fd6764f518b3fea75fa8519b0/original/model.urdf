  <joint name="tower_to_cap" type="continuous">
    <origin xyz="0 0 1.75" rpy="0 0 0" />
    <parent link="tower" />
    <child link="cap" />
    <axis xyz="0 0 1" />
    <limit effort="80" velocity="0.5" />
    </joint>
  <joint name="cap_to_sail_hub" type="continuous">
    <origin xyz="0.65 0 0.25" rpy="0 0 0" />
    <parent link="cap" />
    <child link="sail_hub" />
    <axis xyz="1 0 0" />
    <limit effort="20" velocity="8" />
    </joint>
  </robot>
