        <box size="0.014 0.004 0.064" />
        </geometry>
      <material name="dark_green_enamel">
        <color rgba="0.07 0.18 0.13 1" />
        </material>
      </visual>
    <visual name="guide_rail_1">
      <origin xyz="-0.066 0.046 0.112" rpy="0 0 0" />
      <geometry>
        <box size="0.014 0.004 0.064" />
        </geometry>
      <material name="dark_green_enamel">
        <color rgba="0.07 0.18 0.13 1" />
        </material>
      </visual>
    </link>
  <link name="drawer">
