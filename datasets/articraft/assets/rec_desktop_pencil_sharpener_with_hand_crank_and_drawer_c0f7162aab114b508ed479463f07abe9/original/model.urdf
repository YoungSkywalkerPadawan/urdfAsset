<robot name="vintage_desktop_pencil_sharpener">
  <material name="dark_green_enamel">
    <color rgba="0.07 0.18 0.13 1" />
    </material>
  <material name="aged_brass">
    <color rgba="0.72 0.55 0.28 1" />
    </material>
  <material name="blackened_steel">
    <color rgba="0.025 0.025 0.022 1" />
    </material>
  <material name="brushed_steel">
    <color rgba="0.58 0.6 0.57 1" />
    </material>
  <material name="dark_wood">
    <color rgba="0.4 0.2 0.08 1" />
    </material>
  <link name="body">
    <visual name="housing">
      <geometry>
        <mesh filename="assets/meshes/housing.obj" />
        </geometry>
      <material name="dark_green_enamel">
        <color rgba="0.07 0.18 0.13 1" />
        </material>
      </visual>
    <visual name="guide_rail_0">
