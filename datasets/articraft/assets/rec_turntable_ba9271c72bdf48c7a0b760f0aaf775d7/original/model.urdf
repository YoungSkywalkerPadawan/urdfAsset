  <joint name="platter_spin" type="continuous">
    <origin xyz="-0.04 0 0.068" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="0.8" velocity="12" />
    </joint>
  <joint name="tonearm_swing" type="revolute">
    <origin xyz="0.145 -0.11 0.096" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="tonearm" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="1" lower="0" upper="0.95" />
    </joint>
  </robot>
