    <origin xyz="0.036 0 0.99" rpy="0 0 0" />
    <parent link="tower" />
    <child link="osc_button" />
    <axis xyz="0 0 -1" />
    <limit effort="4" velocity="0.05" lower="0" upper="0.0025" />
    </joint>
