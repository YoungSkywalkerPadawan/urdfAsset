  <joint name="base_to_tower" type="revolute">
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <parent link="base" />
    <child link="tower" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="1.8" lower="-1.05" upper="1.05" />
    </joint>
  <joint name="tower_to_blower" type="continuous">
    <origin xyz="0 0 0.088" rpy="0 0 0" />
    <parent link="tower" />
    <child link="blower" />
    <axis xyz="0 0 1" />
    <limit effort="3" velocity="24" />
    </joint>
  <joint name="tower_to_speed_knob" type="continuous">
    <origin xyz="-0.021 0 0.99" rpy="0 0 0" />
    <parent link="tower" />
    <child link="speed_knob" />
    <axis xyz="0 0 1" />
