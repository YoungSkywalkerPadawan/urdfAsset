  <joint name="plinth_to_side_support_0" type="fixed">
    <origin xyz="-0.065 0.185 0.055" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="side_support_0" />
    </joint>
  <joint name="plinth_to_side_support_1" type="fixed">
