    <child link="side_support_1" />
    </joint>
  <joint name="platter_spin" type="continuous">
    <origin xyz="-0.065 0 0.065" rpy="0 0 0" />
    <parent link="plinth" />
    <child link="platter" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="12" />
    </joint>
  <joint name="plinth_to_tonearm_base" type="fixed">
