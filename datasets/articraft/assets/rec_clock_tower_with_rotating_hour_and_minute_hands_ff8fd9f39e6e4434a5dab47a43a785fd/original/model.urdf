    <origin xyz="0 0.06 0" rpy="0 0 0" />
    <parent link="clock_dial" />
    <child link="hour_hand" />
    <axis xyz="0 1 0" />
    <limit effort="0.5" velocity="1" />
    </joint>
  <joint name="dial_to_minute_hand" type="continuous">
    <origin xyz="0 0.06 0" rpy="0 0 0" />
    <parent link="clock_dial" />
    <child link="minute_hand" />
    <axis xyz="0 1 0" />
    <limit effort="0.5" velocity="2" />
