    <child link="tray" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="0.18" lower="0" upper="0.045" />
    </joint>
  <joint name="body_to_crank" type="continuous">
    <origin xyz="-0.006 0.052 0.048" rpy="0 0 0" />
    <parent link="body" />
    <child link="crank" />
    <axis xyz="0 1 0" />
    <limit effort="1.5" velocity="12" />
    </joint>
  <joint name="body_to_dust_flap" type="revolute">
    <origin xyz="0.0688 0 0.067" rpy="0 0 0" />
    <parent link="body" />
    <child link="dust_flap" />
    <axis xyz="0 -1 0" />
    <limit effort="0.25" velocity="2" lower="0" upper="1.35" />
    </joint>
  </robot>
