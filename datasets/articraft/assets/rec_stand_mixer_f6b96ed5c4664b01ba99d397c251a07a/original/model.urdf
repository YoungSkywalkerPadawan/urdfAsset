    <child link="bowl_carriage" />
    <axis xyz="0 0 1" />
    <limit effort="160" velocity="0.08" lower="0" upper="0.028" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.11 0 0.364" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="24" velocity="1" lower="0" upper="1.01229" />
    </joint>
