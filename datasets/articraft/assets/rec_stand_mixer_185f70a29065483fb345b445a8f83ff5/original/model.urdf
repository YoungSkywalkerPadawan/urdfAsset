  <joint name="base_to_bowl_carriage" type="prismatic">
    <origin xyz="0.11 0 0.018" rpy="0 0 0" />
    <parent link="base" />
    <child link="bowl_carriage" />
    <axis xyz="0 0 1" />
    <limit effort="80" velocity="0.12" lower="0" upper="0.024" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.1 0 0.305" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="25" velocity="1.2" lower="0" upper="1.0472" />
    </joint>
  <joint name="head_to_dough_hook" type="continuous">
    <origin xyz="0.258 0 -0.05" rpy="0 0 0" />
    <parent link="head" />
    <child link="dough_hook" />
    <axis xyz="0 0 1" />
    <limit effort="16" velocity="18" />
    </joint>
  <joint name="base_to_speed_selector" type="revolute">
    <origin xyz="-0.01 0.105 0.122" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_selector" />
    <axis xyz="0 -1 0" />
    <limit effort="1" velocity="2" lower="0" upper="0.5" />
    </joint>
  <joint name="base_to_head_lock" type="prismatic">
    <origin xyz="-0.11 -0.056 0.214" rpy="0 0 0" />
    <parent link="base" />
    <child link="head_lock" />
    <axis xyz="1 0 0" />
    <limit effort="1" velocity="0.04" lower="0" upper="0.012" />
    </joint>
  </robot>
