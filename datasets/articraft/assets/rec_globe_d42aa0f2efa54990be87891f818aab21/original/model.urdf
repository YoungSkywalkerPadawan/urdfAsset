<robot name="celestial_globe_turntable">
  <material name="base_wood">
    <color rgba="0.26 0.17 0.1 1" />
    </material>
  <material name="brass">
    <color rgba="0.77 0.66 0.28 1" />
    </material>
  <material name="globe_blue">
    <color rgba="0.11 0.17 0.29 1" />
    </material>
  <material name="dark_brass">
    <color rgba="0.53 0.43 0.18 1" />
    </material>
  <link name="base">
    <visual name="foot_ring">
      <origin xyz="0 0 0.004" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.18" length="0.008" />
        </geometry>
      <material name="base_wood">
        <color rgba="0.26 0.17 0.1 1" />
        </material>
      </visual>
    <visual name="base_drum">
      <origin xyz="0 0 0.0265" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.16" length="0.037" />
        </geometry>
      <material name="base_wood">
        <color rgba="0.26 0.17 0.1 1" />
        </material>
      </visual>
    </link>
  <link name="upper_assembly">
    <visual name="turntable_plate">
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.158" length="0.012" />
        </geometry>
      <material name="brass">
        <color rgba="0.77 0.66 0.28 1" />
        </material>
      </visual>
    <visual name="turntable_collar">
      <origin xyz="0 0 0.016" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.095" length="0.008" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    <visual name="top_bridge">
      <origin xyz="0.0677873 0 0.3559" rpy="-1.5708 0 0" />
      <geometry>
        <cylinder radius="0.012" length="0.32" />
        </geometry>
      <material name="brass">
        <color rgba="0.77 0.66 0.28 1" />
        </material>
      </visual>
    <visual name="top_pivot">
      <origin xyz="0.0645973 0 0.348564" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.005" length="0.016" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    <visual name="bottom_pivot">
      <origin xyz="-0.0645973 0 0.0514363" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.005" length="0.016" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    <visual name="bottom_pedestal">
      <origin xyz="-0.0645973 0 0.0257181" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.0514363" />
        </geometry>
      <material name="brass">
        <color rgba="0.77 0.66 0.28 1" />
        </material>
      </visual>
    <visual name="pedestal_collar">
      <origin xyz="-0.0645973 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.03" length="0.01" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    <visual name="left_post">
      <geometry>
        <mesh filename="assets/meshes/left_post.obj" />
        </geometry>
      <material name="brass">
        <color rgba="0.77 0.66 0.28 1" />
        </material>
      </visual>
    <visual name="right_post">
      <geometry>
        <mesh filename="assets/meshes/right_post.obj" />
        </geometry>
      <material name="brass">
        <color rgba="0.77 0.66 0.28 1" />
        </material>
      </visual>
    </link>
  <link name="globe">
    <visual name="globe_shell">
      <geometry>
        <sphere radius="0.14" />
        </geometry>
      <material name="globe_blue">
        <color rgba="0.11 0.17 0.29 1" />
        </material>
      </visual>
    <visual name="top_axle">
      <origin xyz="0.0586161 0 0.134808" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.006" length="0.014" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    <visual name="bottom_axle">
      <origin xyz="-0.0586161 0 -0.134808" rpy="0 0.410152 0" />
      <geometry>
        <cylinder radius="0.006" length="0.014" />
        </geometry>
      <material name="dark_brass">
        <color rgba="0.53 0.43 0.18 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_upper" type="continuous">
    <origin xyz="0 0 0.045" rpy="0 0 0" />
    <parent link="base" />
    <child link="upper_assembly" />
    <axis xyz="0 0 1" />
    <limit effort="2" velocity="3" />
    </joint>
  <joint name="upper_to_globe" type="continuous">
    <origin xyz="0 0 0.2" rpy="0 0 0" />
    <parent link="upper_assembly" />
    <child link="globe" />
    <axis xyz="0.398749 0 0.91706" />
    <limit effort="1" velocity="4" />
    </joint>
  </robot>
