<robot name="tower_fan">
  <material name="base_silver">
    <color rgba="0.74 0.75 0.77 1" />
    </material>
  <material name="body_graphite">
    <color rgba="0.2 0.22 0.24 1" />
    </material>
  <material name="grille_black">
    <color rgba="0.1 0.11 0.12 1" />
    </material>
  <material name="knob_black">
    <color rgba="0.12 0.13 0.14 1" />
    </material>
  <material name="indicator">
    <color rgba="0.82 0.83 0.84 1" />
    </material>
  <material name="spindle_dark">
    <color rgba="0.18 0.18 0.19 1" />
    </material>
  <link name="stand">
    <inertial>
      <origin xyz="0 0 0.042" rpy="0 0 0" />
      <mass value="5.2" />
      <inertia ixx="0.0233701" ixy="0" ixz="0" iyy="0.0233701" iyz="0" izz="0.040625" />
      </inertial>
    <visual name="base_plate">
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.125" length="0.02" />
        </geometry>
      <material name="base_silver" />
      </visual>
    <visual name="foot_ring">
      <origin xyz="0 0 0.002" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.108" length="0.004" />
        </geometry>
      <material name="grille_black" />
      </visual>
    <visual name="neck">
      <origin xyz="0 0 0.046" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.052" />
        </geometry>
      <material name="base_silver" />
      </visual>
    <visual name="turntable">
      <origin xyz="0 0 0.078" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.056" length="0.012" />
        </geometry>
      <material name="body_graphite" />
      </visual>
    </link>
  <link name="body">
    <inertial>
      <origin xyz="0 0 0.353" rpy="0 0 0" />
      <mass value="3.4" />
      <inertia ixx="0.145304" ixy="0" ixz="0" iyy="0.145304" iyz="0" izz="0.00816" />
      </inertial>
    <visual name="base_ring">
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.018" />
        </geometry>
      <material name="body_graphite" />
      </visual>
    <visual name="shell">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/tower_fan_shell.obj" />
        </geometry>
      <material name="body_graphite" />
      </visual>
    <visual name="control_deck">
      <origin xyz="0 0 0.692" rpy="0 0 0" />
      <geometry>
        <box size="0.074 0.084 0.008" />
        </geometry>
      <material name="body_graphite" />
      </visual>
    <visual name="front_grille">
      <origin xyz="0 0.059 0.3685" rpy="-1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/tower_fan_front_grille.obj" />
        </geometry>
      <material name="grille_black" />
      </visual>
    <visual name="rear_intake">
      <origin xyz="0 -0.0585 0.348" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/tower_fan_rear_intake.obj" />
        </geometry>
      <material name="grille_black" />
      </visual>
    <visual name="spindle">
      <origin xyz="0 0 0.3685" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0045" length="0.637" />
        </geometry>
      <material name="spindle_dark" />
      </visual>
    </link>
  <link name="blower">
    <inertial>
      <mass value="0.55" />
      <inertia ixx="0.0145141" ixy="0" ixz="0" iyy="0.0145141" iyz="0" izz="0.0002816" />
      </inertial>
    <visual name="blower_wheel">
      <geometry>
        <mesh filename="assets/meshes/tower_fan_blower.obj" />
        </geometry>
      <material name="base_silver" />
      </visual>
    <visual name="bearing_spider">
      <origin xyz="0 0 0.278" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/tower_fan_blower_spider.obj" />
        </geometry>
      <material name="spindle_dark" />
      </visual>
    <visual name="drive_tab">
      <origin xyz="0.021 0 0.276" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.004 0.006" />
        </geometry>
      <material name="indicator" />
      </visual>
    </link>
  <link name="timer_knob">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="3.94479e-06" ixy="0" ixz="0" iyy="3.94479e-06" iyz="0" izz="4.55625e-06" />
      </inertial>
    <visual name="knob_body">
      <origin xyz="0 0 0.008" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0135" length="0.016" />
        </geometry>
      <material name="knob_black" />
      </visual>
    <visual name="knob_cap">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.00972" length="0.004" />
        </geometry>
      <material name="knob_black" />
      </visual>
    <visual name="pointer">
      <origin xyz="0.006075 0 0.019" rpy="0 0 0" />
      <geometry>
        <box size="0.0081 0.003 0.002" />
        </geometry>
      <material name="indicator" />
      </visual>
    </link>
  <link name="speed_knob">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="4.47917e-06" ixy="0" ixz="0" iyy="4.47917e-06" iyz="0" izz="5.625e-06" />
      </inertial>
    <visual name="knob_body">
      <origin xyz="0 0 0.008" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.016" />
        </geometry>
      <material name="knob_black" />
      </visual>
    <visual name="knob_cap">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0108" length="0.004" />
        </geometry>
      <material name="knob_black" />
      </visual>
    <visual name="pointer">
      <origin xyz="0.00675 0 0.019" rpy="0 0 0" />
      <geometry>
        <box size="0.009 0.003 0.002" />
        </geometry>
      <material name="indicator" />
      </visual>
    </link>
  <joint name="stand_to_body" type="revolute">
    <origin xyz="0 0 0.084" rpy="0 0 0" />
    <parent link="stand" />
    <child link="body" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="1.5" lower="-0.95" upper="0.95" />
    </joint>
  <joint name="body_to_blower" type="continuous">
    <origin xyz="0 0 0.3685" rpy="0 0 0" />
    <parent link="body" />
    <child link="blower" />
    <axis xyz="0 0 1" />
    <limit effort="0.6" velocity="28" />
    </joint>
  <joint name="body_to_timer_knob" type="revolute">
    <origin xyz="-0.022 -0.002 0.696" rpy="0 0 0" />
    <parent link="body" />
    <child link="timer_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.15" velocity="3" lower="0" upper="4.8" />
    </joint>
  <joint name="body_to_speed_knob" type="revolute">
    <origin xyz="0.022 -0.002 0.696" rpy="0 0 0" />
    <parent link="body" />
    <child link="speed_knob" />
    <axis xyz="0 0 1" />
    <limit effort="0.15" velocity="3" lower="0" upper="4.8" />
    </joint>
  </robot>
