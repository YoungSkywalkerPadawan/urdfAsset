        </material>
      </visual>
    <visual name="secondary_meridian_band">
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708" />
      <geometry>
        <mesh filename="assets/meshes/globe_meridian_band.obj" />
        </geometry>
      <material name="parchment">
        <color rgba="0.86 0.82 0.7 1" />
        </material>
      </visual>
    </link>
  <joint name="gimbal_tilt" type="revolute">
    <origin xyz="0 0 0.62" rpy="0 0 0" />
    <parent link="pedestal_cradle" />
    <child link="inner_ring" />
    <axis xyz="1 0 0" />
    <limit effort="18" velocity="1.2" lower="-0.65" upper="0.65" />
    </joint>
  <joint name="globe_spin" type="continuous">
    <parent link="inner_ring" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="4" velocity="2.4" />
    </joint>
  </robot>
