  <link name="globe">
    <inertial>
      <mass value="2.4" />
      <inertia ixx="0.018816" ixy="0" ixz="0" iyy="0.018816" iyz="0" izz="0.018816" />
      </inertial>
    <visual name="globe_surface">
      <geometry>
        <sphere radius="0.14" />
        </geometry>
      <material name="ocean_blue">
        <color rgba="0.15 0.32 0.56 1" />
        </material>
      </visual>
    <visual name="map_tint">
      <geometry>
        <sphere radius="0.135" />
        </geometry>
      <material name="parchment">
        <color rgba="0.86 0.82 0.7 1" />
        </material>
      </visual>
    <visual name="polar_spindle">
      <geometry>
        <cylinder radius="0.0065" length="0.32" />
        </geometry>
      <material name="brass">
        <color rgba="0.78 0.67 0.35 1" />
        </material>
