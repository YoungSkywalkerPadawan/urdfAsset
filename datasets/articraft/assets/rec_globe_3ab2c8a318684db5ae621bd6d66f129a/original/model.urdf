    <visual name="equator_band">
      <geometry>
        <mesh filename="assets/meshes/globe_equator_band.obj" />
        </geometry>
      <material name="parchment">
        <color rgba="0.86 0.82 0.7 1" />
        </material>
      </visual>
    <visual name="prime_meridian_band">
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <mesh filename="assets/meshes/globe_meridian_band.obj" />
        </geometry>
