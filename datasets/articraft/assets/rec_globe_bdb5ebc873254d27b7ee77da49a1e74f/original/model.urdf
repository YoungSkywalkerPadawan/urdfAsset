    <visual name="right_fork_arm">
      <origin xyz="0.19 0 0.217" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.012" length="0.186" />
        </geometry>
      <material name="stand_finish">
        <color rgba="0.23 0.19 0.16 1" />
        </material>
      </visual>
    <visual name="left_fork_bearing">
      <origin xyz="-0.184 0 0.31" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.012" length="0.016" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    <visual name="right_fork_bearing">
      <origin xyz="0.184 0 0.31" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.012" length="0.016" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="meridian">
    <inertial>
      <mass value="0.8" />
      <inertia ixx="0.00581227" ixy="0" ixz="0" iyy="0.00581227" iyz="0" izz="0.01156" />
      </inertial>
    <visual name="meridian_ring">
      <geometry>
        <mesh filename="assets/meshes/meridian_ring.obj" />
        </geometry>
      <material name="brass">
        <color rgba="0.69 0.56 0.24 1" />
        </material>
      </visual>
    <visual name="left_pivot_boss">
      <origin xyz="-0.168 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.011" length="0.016" />
        </geometry>
      <material name="brass">
        <color rgba="0.69 0.56 0.24 1" />
        </material>
      </visual>
    <visual name="right_pivot_boss">
      <origin xyz="0.168 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.011" length="0.016" />
        </geometry>
      <material name="brass">
        <color rgba="0.69 0.56 0.24 1" />
        </material>
      </visual>
    <visual name="top_bearing">
      <origin xyz="0 0 0.156" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.014" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    <visual name="bottom_bearing">
      <origin xyz="0 0 -0.156" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.009" length="0.014" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="globe">
    <inertial>
      <mass value="1.2" />
      <inertia ixx="0.00836352" ixy="0" ixz="0" iyy="0.00836352" iyz="0" izz="0.00836352" />
      </inertial>
    <visual name="globe_shell">
      <geometry>
        <sphere radius="0.132" />
        </geometry>
      <material name="ocean_blue">
        <color rgba="0.24 0.48 0.76 1" />
        </material>
      </visual>
    <visual name="equator_band">
      <geometry>
        <mesh filename="assets/meshes/globe_equator_band_v1.obj" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    <visual name="axis_spindle">
      <geometry>
        <cylinder radius="0.003" length="0.298" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    <visual name="north_trunnion">
      <origin xyz="0 0 0.1405" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.017" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    <visual name="south_trunnion">
      <origin xyz="0 0 -0.1405" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.006" length="0.017" />
        </geometry>
      <material name="ivory">
        <color rgba="0.94 0.91 0.82 1" />
        </material>
      </visual>
    </link>
  <joint name="stand_to_meridian" type="revolute">
    <origin xyz="0 0 0.31" rpy="0 0 0" />
    <parent link="stand" />
    <child link="meridian" />
    <axis xyz="1 0 0" />
    <limit effort="6" velocity="1.5" lower="-0.55" upper="0.8" />
    </joint>
  <joint name="meridian_to_globe" type="continuous">
    <parent link="meridian" />
    <child link="globe" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="3" />
    </joint>
  </robot>
