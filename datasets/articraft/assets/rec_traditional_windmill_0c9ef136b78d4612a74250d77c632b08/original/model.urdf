  <joint name="base_to_bearing" type="fixed">
    <origin xyz="0 0 8" rpy="0 0 0" />
    <parent link="tower_base" />
    <child link="bearing_module" />
    </joint>
  <joint name="bearing_to_cap" type="continuous">
    <origin xyz="0 0 0.52" rpy="0 0 0" />
    <parent link="bearing_module" />
    <child link="cap_shell" />
    <axis xyz="0 0 1" />
    <limit effort="4000" velocity="0.4" />
    </joint>
  <joint name="cap_to_head_frame" type="fixed">
    <origin xyz="1.96 0 1.05" rpy="0 0 0" />
    <parent link="cap_shell" />
    <child link="head_frame" />
    </joint>
  <joint name="head_to_sail_hub" type="continuous">
    <origin xyz="0.85 0 0" rpy="0 0 0" />
    <parent link="head_frame" />
    <child link="sail_hub" />
    <axis xyz="1 0 0" />
    <limit effort="2500" velocity="2.2" />
    </joint>
  </robot>
