    <child link="main_rotor" />
    <axis xyz="0 0 1" />
    <limit effort="1800" velocity="40" />
    </joint>
  <joint name="body_to_tail_rotor" type="continuous">
    <origin xyz="7.28 -0.61 2.56" rpy="0 0 0" />
