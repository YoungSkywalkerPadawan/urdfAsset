        </geometry>
      <material name="dark_steel">
        <color rgba="0.22 0.24 0.27 1" />
        </material>
      </visual>
    <visual name="tower_column">
      <origin xyz="0 0 0.83" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.15" length="0.58" />
        </geometry>
      <material name="white_paint">
        <color rgba="0.9 0.92 0.94 1" />
        </material>
      </visual>
    </link>
  <link name="nacelle">
    <inertial>
      <origin xyz="-0.02 0 0.04" rpy="0 0 0" />
      <mass value="24" />
      <inertia ixx="0.416" ixy="0" ixz="0" iyy="1.3544" iyz="0" izz="1.252" />
