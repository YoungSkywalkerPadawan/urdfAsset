      <mass value="18" />
      <inertia ixx="2.1294" ixy="0" ixz="0" iyy="2.1294" iyz="0" izz="4.1616" />
      </inertial>
    <visual name="hub_shell">
      <origin xyz="0.06 0 0" rpy="0 1.5708 0" />
      <geometry>
