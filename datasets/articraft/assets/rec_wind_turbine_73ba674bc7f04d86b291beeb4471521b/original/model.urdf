  <joint name="support_to_nacelle_yaw" type="continuous">
    <origin xyz="0 0 1.12" rpy="0 0 0" />
    <parent link="support" />
    <child link="nacelle" />
    <axis xyz="0 0 1" />
    <limit effort="500" velocity="1" />
    </joint>
  <joint name="nacelle_to_rotor_spin" type="continuous">
    <origin xyz="0.41 0 0.14" rpy="0 0 0" />
    <parent link="nacelle" />
    <child link="rotor" />
    <axis xyz="1 0 0" />
    <limit effort="120" velocity="8" />
    </joint>
  </robot>
