<robot name="windmill">
  <link name="tower">
    <visual name="tower_visual">
      <geometry>
        <mesh filename="assets/meshes/tower_shell.obj" />
        </geometry>
      </visual>
    </link>
  <link name="cap">
    <visual name="cap_visual">
      <geometry>
        <mesh filename="assets/meshes/cap_shell.obj" />
        </geometry>
      </visual>
    </link>
  <link name="sail_hub">
    <visual name="hub_visual">
      <geometry>
        <mesh filename="assets/meshes/hub_geom.obj" />
        </geometry>
      </visual>
    </link>
  <joint name="tower_to_cap" type="continuous">
    <origin xyz="0 0 10" rpy="0 0 0" />
    <parent link="tower" />
    <child link="cap" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="1" />
    </joint>
  <joint name="cap_to_hub" type="continuous">
    <origin xyz="0 3.5 1.5" rpy="0 0 0" />
    <parent link="cap" />
    <child link="sail_hub" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="5" />
    </joint>
  </robot>
