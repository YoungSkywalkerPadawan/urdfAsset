<robot name="modern_countertop_stand_mixer">
  <material name="body_finish">
    <color rgba="0.86 0.86 0.84 1" />
    </material>
  <material name="steel">
    <color rgba="0.78 0.8 0.82 1" />
    </material>
  <material name="dark_trim">
    <color rgba="0.16 0.16 0.18 1" />
    </material>
  <link name="base">
    <inertial>
      <origin xyz="-0.02 0 0.16" rpy="0 0 0" />
      <mass value="9" />
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.174" iyz="0" izz="0.1404" />
      </inertial>
    <visual name="base_plate">
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/base_plate.obj" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.86 0.86 0.84 1" />
        </material>
      </visual>
    <visual name="rear_pedestal">
      <origin xyz="-0.14 0 0.036" rpy="0 0 0" />
      <geometry>
        <mesh filename="assets/meshes/rear_pedestal.obj" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.86 0.86 0.84 1" />
        </material>
      </visual>
    <visual name="right_slide_rail">
      <origin xyz="0.09 0.045 0.043" rpy="0 0 0" />
      <geometry>
        <box size="0.18 0.022 0.014" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="left_slide_rail">
      <origin xyz="0.09 -0.045 0.043" rpy="0 0 0" />
      <geometry>
        <box size="0.18 0.022 0.014" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="head_lock_track">
      <origin xyz="-0.108 0 0.319" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.028 0.002" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    </link>
  <link name="carriage">
    <inertial>
      <origin xyz="0.01 0 0.018" rpy="0 0 0" />
      <mass value="0.9" />
      <inertia ixx="0.0016575" ixy="0" ixz="0" iyy="0.0026175" iyz="0" izz="0.0039" />
      </inertial>
    <visual name="runner">
      <geometry>
        <box size="0.12 0.058 0.014" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="carriage_platform">
      <origin xyz="0.01 0 0.014" rpy="0 0 0" />
      <geometry>
        <box size="0.18 0.14 0.014" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.86 0.86 0.84 1" />
        </material>
      </visual>
    <visual name="bowl_seat">
      <origin xyz="0 0 0.031" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.02" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    </link>
  <link name="bowl">
    <inertial>
      <origin xyz="0 0 0.082" rpy="0 0 0" />
      <mass value="1.4" />
      <inertia ixx="0.00817787" ixy="0" ixz="0" iyy="0.00817787" iyz="0" izz="0.01008" />
      </inertial>
    <visual name="bowl_shell">
      <geometry>
        <mesh filename="assets/meshes/mixing_bowl.obj" />
        </geometry>
      <material name="steel">
        <color rgba="0.78 0.8 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="head">
    <inertial>
      <origin xyz="0.165 0 -0.02" rpy="0 0 0" />
      <mass value="4.8" />
      <inertia ixx="0.0218" ixy="0" ixz="0" iyy="0.0538" iyz="0" izz="0.05512" />
      </inertial>
    <visual name="head_shell">
      <geometry>
        <mesh filename="assets/meshes/head_shell.obj" />
        </geometry>
      <material name="body_finish">
        <color rgba="0.86 0.86 0.84 1" />
        </material>
      </visual>
    </link>
  <link name="speed_selector">
    <inertial>
      <origin xyz="0 0 0.011" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="1.48333e-05" ixy="0" ixz="0" iyy="1.48333e-05" iyz="0" izz="2.16e-05" />
      </inertial>
    <visual name="selector_skirt">
      <origin xyz="0 0 0.002" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.004" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="selector_knob">
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.014" length="0.012" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="selector_pointer">
      <origin xyz="0.01 0 0.018" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.006 0.004" />
        </geometry>
      <material name="steel">
        <color rgba="0.78 0.8 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="head_lock_control">
    <inertial>
      <origin xyz="0.014 0 0.006" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="3.4e-06" ixy="0" ixz="0" iyy="5.48e-06" iyz="0" izz="6.92e-06" />
      </inertial>
    <visual name="lock_tab">
      <origin xyz="0.015 0 0.004" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.022 0.008" />
        </geometry>
      <material name="dark_trim">
        <color rgba="0.16 0.16 0.18 1" />
        </material>
      </visual>
    <visual name="lock_thumb">
      <origin xyz="0.006 0 0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.01 0.008" />
        </geometry>
      <material name="steel">
        <color rgba="0.78 0.8 0.82 1" />
        </material>
      </visual>
    </link>
  <link name="tool">
    <inertial>
      <origin xyz="0 0 -0.075" rpy="0 0 0" />
      <mass value="0.4" />
      <inertia ixx="0.00084" ixy="0" ixz="0" iyy="0.00084" iyz="0" izz="0.00018" />
      </inertial>
    <visual name="dough_hook">
      <geometry>
        <mesh filename="assets/meshes/dough_hook.obj" />
        </geometry>
      <material name="steel">
        <color rgba="0.78 0.8 0.82 1" />
        </material>
      </visual>
    </link>
  <joint name="base_to_carriage" type="prismatic">
    <origin xyz="0.07 0 0.043" rpy="0 0 0" />
    <parent link="base" />
    <child link="carriage" />
    <axis xyz="1 0 0" />
    <limit effort="80" velocity="0.1" lower="0" upper="0.04" />
    </joint>
  <joint name="carriage_to_bowl" type="fixed">
    <origin xyz="0 0 0.041" rpy="0 0 0" />
    <parent link="carriage" />
    <child link="bowl" />
    </joint>
  <joint name="base_to_head" type="revolute">
    <origin xyz="-0.07 0 0.335" rpy="0 0 0" />
    <parent link="base" />
    <child link="head" />
    <axis xyz="0 -1 0" />
    <limit effort="18" velocity="1" lower="0" upper="1.0821" />
    </joint>
  <joint name="base_to_speed_selector" type="revolute">
    <origin xyz="0.108 0.102 0.036" rpy="0 0 0" />
    <parent link="base" />
    <child link="speed_selector" />
    <axis xyz="0 0 1" />
    <limit effort="1" velocity="4" lower="0" upper="2.44346" />
    </joint>
  <joint name="base_to_head_lock_control" type="prismatic">
    <origin xyz="-0.123 0 0.32" rpy="0 0 0" />
    <parent link="base" />
    <child link="head_lock_control" />
    <axis xyz="1 0 0" />
    <limit effort="8" velocity="0.08" lower="0" upper="0.012" />
    </joint>
  <joint name="head_to_tool" type="continuous">
    <origin xyz="0.14 0 -0.06" rpy="0 0 0" />
    <parent link="head" />
    <child link="tool" />
    <axis xyz="0 0 1" />
    <limit effort="15" velocity="18" />
    </joint>
  </robot>
