      <geometry>
        <mesh filename="meshes/base_link.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.obj" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0003452599049 -0.0004730597138 0.2999999821" rpy="0 0 0" />
      <mass value="8" />
      <inertia ixx="0.3501463753159868" iyy="0.4267120478207313" izz="0.2968584803571754" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="turntable">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/turntable.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/turntable.obj" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0001142174006 0.0002339035273 0.02798157185" rpy="0 0 0" />
      <mass value="2" />
      <inertia ixx="0.045452877974037076" iyy="0.045399985122326715" izz="0.08990789829278138" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="cutting_roller">
